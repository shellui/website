{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "gold": {
    "brand": {
      "$value": "#E3A512",
      "$type": "color",
      "pantone": { "coated": "124 C", "uncoated": "7405 U" },
      "cmyk": "11 38 100 0"
    },
    "text": {
      "$value": "#8A6300",
      "$type": "color",
      "pantone": { "coated": "4027 C" },
      "role": "Gold text and links on light backgrounds"
    },
    "textDark": {
      "$value": "#E8B84A",
      "$type": "color",
      "role": "Gold text and links on dark backgrounds"
    },
    "on": {
      "$value": "#1A1408",
      "$type": "color",
      "role": "Text on gold fills"
    }
  },
  "canvas": {
    "background": { "$value": "#FFFFFF", "$type": "color", "dark": "#030712" },
    "foreground": { "$value": "#111827", "$type": "color", "dark": "#F9FAFB" },
    "muted": { "$value": "#F9FAFB", "$type": "color", "dark": "rgb(255 255 255 / 0.05)" },
    "mutedForeground": { "$value": "#4B5563", "$type": "color", "dark": "#9CA3AF" }
  },
  "structure": {
    "border": { "$value": "#E5E7EB", "$type": "color", "dark": "#1F2937" },
    "card": { "$value": "#FFFFFF", "$type": "color", "dark": "#111827" },
    "cardForeground": { "$value": "#111827", "$type": "color", "dark": "#F9FAFB" },
    "ring": { "$value": "#E3A512", "$type": "color", "dark": "#E8B84A" }
  },
  "semantic": {
    "destructive": { "$value": "#DC2626", "$type": "color" },
    "secondary": { "$value": "#F3F4F6", "$type": "color", "dark": "#1F2937" },
    "secondaryForeground": { "$value": "#111827", "$type": "color", "dark": "#F9FAFB" },
    "accent": { "$value": "#F9FAFB", "$type": "color", "dark": "rgb(255 255 255 / 0.05)" },
    "accentForeground": { "$value": "#111827", "$type": "color", "dark": "#F9FAFB" },
    "input": { "$value": "#E5E7EB", "$type": "color", "dark": "#1F2937" },
    "popover": { "$value": "#FFFFFF", "$type": "color", "dark": "#111827" },
    "popoverForeground": { "$value": "#111827", "$type": "color", "dark": "#F9FAFB" }
  },
  "radius": {
    "sm": { "$value": "0.25rem", "$type": "dimension" },
    "md": { "$value": "0.375rem", "$type": "dimension" },
    "lg": { "$value": "0.75rem", "$type": "dimension" }
  },
  "typography": {
    "web": {
      "family": { "$value": "Inter", "$type": "fontFamily" },
      "fallback": { "$value": "system-ui, sans-serif", "$type": "fontFamily" }
    },
    "print": {
      "family": { "$value": "IBM Plex Sans", "$type": "fontFamily" },
      "mono": { "$value": "IBM Plex Mono", "$type": "fontFamily" }
    }
  }
}
