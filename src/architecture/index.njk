---
layout: layouts/base.njk
title: Architecture | Shellui
description: High-level architecture overview of the Shellui platform.
---

<style>
  [x-cloak] { display: none !important; }
  .arch-canvas { touch-action: none; }
  .arch-canvas * { user-select: none; }
  .node-card {
    position: absolute;
    border-radius: 12px;
    border: 2px solid;
    background: white;
    box-shadow: 0 1px 3px rgba(0,0,0,.08), 0 4px 12px rgba(0,0,0,.04);
    cursor: grab;
    transition: box-shadow .2s, border-color .2s;
    overflow: hidden;
  }
  .node-card:hover, .node-card.is-active {
    box-shadow: 0 4px 20px rgba(0,0,0,.12);
    z-index: 10;
  }
  .node-card:active { cursor: grabbing; }
  .dark .node-card {
    background: #111827;
    box-shadow: 0 1px 3px rgba(0,0,0,.3), 0 4px 12px rgba(0,0,0,.2);
  }
  .node-accent {
    height: 4px;
    width: 100%;
  }
  .handle {
    width: 8px; height: 8px;
    border-radius: 50%;
    border: 2px solid;
    background: white;
    position: absolute;
    z-index: 5;
  }
  .dark .handle { background: #111827; }
  .handle-bottom { bottom: -5px; left: 50%; transform: translateX(-50%); }
  .handle-top { top: -5px; left: 50%; transform: translateX(-50%); }
</style>

<article class="px-4 py-20 pt-32 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-3xl mb-8">
    <p class="mb-3 text-sm font-medium text-primary-ink dark:text-primary">Developers</p>
    <h1 class="text-4xl font-bold text-gray-900 md:text-5xl dark:text-white">Architecture</h1>
    <p class="mt-4 text-lg text-gray-600 dark:text-gray-400">
      Interactive diagram of the Shellui platform. Drag nodes to rearrange, click to view details.
    </p>
  </div>

  <div class="mx-auto max-w-7xl" x-data="flowDiagram()" x-init="init()">

    <!-- Toolbar -->
    <div class="flex items-center justify-between mb-4 px-2">
      <div class="flex flex-wrap gap-3 text-xs text-gray-500 dark:text-gray-400">
        <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>Core</span>
        <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-blue-500"></span>Backend</span>
        <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>Infrastructure</span>
        <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-purple-500"></span>Developer Tools</span>
      </div>
      <div class="flex items-center gap-1">
        <button x-on:click="zoomIn()" class="p-1.5 rounded-lg text-gray-400 hover:text-gray-600 hover:bg-gray-100 dark:hover:text-gray-300 dark:hover:bg-gray-800 transition-colors" title="Zoom in">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 6v12M6 12h12"/></svg>
        </button>
        <button x-on:click="zoomOut()" class="p-1.5 rounded-lg text-gray-400 hover:text-gray-600 hover:bg-gray-100 dark:hover:text-gray-300 dark:hover:bg-gray-800 transition-colors" title="Zoom out">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 12h12"/></svg>
        </button>
        <button x-on:click="resetView()" class="p-1.5 rounded-lg text-gray-400 hover:text-gray-600 hover:bg-gray-100 dark:hover:text-gray-300 dark:hover:bg-gray-800 transition-colors" title="Reset view">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 8V4m0 0h4M4 4l5 5m11-5h-4m4 0v4m0 0l-5-5M4 16v4m0 0h4m-4 0l5-5m11 5h-4m4 0v-4m0 0l-5 5"/></svg>
        </button>
      </div>
    </div>

    <!-- Canvas -->
    <div class="relative rounded-2xl border border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-950 overflow-hidden arch-canvas"
      style="height: 680px;"
      x-ref="canvas"
      x-on:mousedown.self="startPan($event)"
      x-on:mousemove.window="onMouseMove($event)"
      x-on:mouseup.window="onMouseUp()"
      x-on:wheel="onWheel($event)"
      x-on:touchstart.self="startPan($event)"
      x-on:touchmove="onTouchMove($event)"
      x-on:touchend="onMouseUp()">

      <!-- Grid dots -->
      <svg class="absolute inset-0 w-full h-full pointer-events-none" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="grid" width="20" height="20" patternUnits="userSpaceOnUse"
            :patternTransform="`translate(${panX}, ${panY}) scale(${zoom})`">
            <circle cx="10" cy="10" r="0.8" class="fill-gray-300 dark:fill-gray-700" />
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#grid)" />
      </svg>

      <!-- Edges SVG -->
      <svg class="absolute inset-0 w-full h-full pointer-events-none" xmlns="http://www.w3.org/2000/svg">
        <template x-for="e in edges" :key="e.from + '-' + e.to">
          <path :d="edgePath(e)" fill="none" stroke-width="1.5"
            class="stroke-gray-300 dark:stroke-gray-700"
            :style="e.animated ? 'stroke-dasharray: 5 5; animation: dash 0.5s linear infinite' : ''" />
        </template>
      </svg>

      <!-- Nodes -->
      <div :style="`transform: translate(${panX}px, ${panY}px) scale(${zoom}); transform-origin: 0 0;`"
        class="absolute inset-0">
        <template x-for="n in nodes" :key="n.id">
          <div class="node-card"
            :class="{'is-active': selected === n.id}"
            :style="`left:${n.x}px; top:${n.y}px; width:${n.w}px; border-color:${selected === n.id ? n.color : (hovered === n.id ? n.color : 'var(--border-color, #e5e7eb)')};`"
            x-on:mousedown.stop="startDrag(n.id, $event)"
            x-on:touchstart.stop.prevent="startDrag(n.id, $event)"
            x-on:click="selectNode(n.id)"
            x-on:mouseenter="hovered = n.id"
            x-on:mouseleave="hovered = null">
            <div class="node-accent" :style="`background:${n.color}`"></div>
            <div class="px-4 py-3">
              <div class="flex items-center gap-2 mb-1">
                <span class="w-2 h-2 rounded-full" :style="`background:${n.color}`"></span>
                <span class="text-[10px] font-semibold uppercase tracking-wider text-gray-400 dark:text-gray-500" x-text="n.category"></span>
              </div>
              <div class="text-sm font-semibold text-gray-900 dark:text-white leading-tight" x-text="n.label"></div>
              <div class="text-[11px] text-gray-500 dark:text-gray-400 mt-1 leading-snug" x-text="n.sub"></div>
              <template x-if="n.repo">
                <div class="text-[10px] text-gray-400 dark:text-gray-600 mt-1.5 truncate" x-text="n.repo.replace('https://github.com/', '')"></div>
              </template>
            </div>
            <div class="handle handle-bottom" :style="`border-color:${n.color}`" x-show="n.handlesBottom"></div>
            <div class="handle handle-top" :style="`border-color:${n.color}`" x-show="n.handlesTop"></div>
          </div>
        </template>
      </div>
    </div>

    <!-- Detail panel -->
    <div x-show="selected && getNode(selected)" x-transition x-cloak
      class="mt-6 rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 p-6 shadow-sm">
      <template x-if="selected && getNode(selected)">
        <div>
          <div class="flex items-start justify-between">
            <div>
              <div class="flex items-center gap-2 mb-1">
                <span class="w-3 h-3 rounded-full" :style="`background:${getNode(selected).color}`"></span>
                <span class="text-xs font-medium uppercase tracking-wider text-gray-400" x-text="getNode(selected).category"></span>
              </div>
              <h3 class="text-xl font-semibold text-gray-900 dark:text-white" x-text="getNode(selected).label"></h3>
              <p class="mt-2 text-sm text-gray-600 dark:text-gray-400 max-w-2xl" x-text="getNode(selected).description"></p>
            </div>
            <button x-on:click="selected = null" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 ml-4 flex-shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
          </div>
          <div class="mt-4 flex flex-wrap gap-2">
            <template x-if="getNode(selected).url">
              <a :href="getNode(selected).url" target="_blank" rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 rounded-lg bg-primary/10 px-3 py-1.5 text-xs font-medium text-primary-ink dark:text-primary hover:bg-primary/20 transition-colors">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                <span x-text="getNode(selected).urlLabel || 'Visit'"></span>
              </a>
            </template>
            <template x-if="getNode(selected).repo">
              <a :href="getNode(selected).repo" target="_blank" rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 rounded-lg bg-gray-100 dark:bg-gray-800 px-3 py-1.5 text-xs font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors">
                <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                <span>GitHub</span>
              </a>
            </template>
            <template x-if="getNode(selected).featurePage">
              <a :href="getNode(selected).featurePage"
                class="inline-flex items-center gap-1.5 rounded-lg bg-gray-100 dark:bg-gray-800 px-3 py-1.5 text-xs font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                <span>Feature page</span>
              </a>
            </template>
          </div>
          <template x-if="getNode(selected).tech">
            <div class="mt-3 flex flex-wrap gap-1.5">
              <template x-for="t in getNode(selected).tech" :key="t">
                <span class="rounded-full bg-gray-100 dark:bg-gray-800 px-2.5 py-0.5 text-[10px] font-medium text-gray-500 dark:text-gray-400" x-text="t"></span>
              </template>
            </div>
          </template>
        </div>
      </template>
    </div>

  </div>
</article>

<style>
  @keyframes dash { to { stroke-dashoffset: -10; } }
  :root { --border-color: #e5e7eb; }
  .dark { --border-color: #374151; }
</style>

<script>
function flowDiagram() {
  return {
    zoom: 1,
    panX: 0,
    panY: 0,
    dragging: null,
    didDrag: false,
    panning: false,
    dragOffsetX: 0,
    dragOffsetY: 0,
    panStartX: 0,
    panStartY: 0,
    panStartPanX: 0,
    panStartPanY: 0,
    selected: null,
    hovered: null,

    nodes: [
      { id: 'shell', x: 320, y: 30, w: 280, label: 'Shellui Shell', sub: 'Microfrontend runtime · Navigation · Themes · i18n · Offline', category: 'Core', color: '#f59e0b',
        handlesBottom: true, handlesTop: false,
        description: 'The microfrontend runtime that stitches your apps together. Sidebar navigation, layout modes, modals, drawers, themes, i18n, toasts, settings, cookie consent, and offline support — all from shellui.config.ts.',
        url: 'https://shellui.com', urlLabel: 'shellui.com', repo: 'https://github.com/shellui', featurePage: '/features/microfrontend/',
        tech: ['TypeScript', 'Alpine.js', 'Tailwind CSS', 'Vite'] },

      { id: 'identity', x: 40, y: 210, w: 240, label: 'Identity Service', sub: 'OAuth · JWT · User management · Protected routes', category: 'Backend', color: '#3b82f6',
        handlesBottom: true, handlesTop: true,
        description: 'Backend service handling OAuth flows, JWT sessions, user registration, and protected-page redirects. Swap with Supabase Auth for a fully managed alternative.',
        url: 'https://github.com/shellui/identity-service', urlLabel: 'Repository', repo: 'https://github.com/shellui/identity-service', featurePage: '/features/authentication/',
        tech: ['Python', 'Django', 'Django REST Framework', 'JWT', 'OAuth2'] },

      { id: 'storage', x: 330, y: 210, w: 240, label: 'Storage Service', sub: 'S3-compatible · Upload · Download · Access control', category: 'Backend', color: '#3b82f6',
        handlesBottom: true, handlesTop: true,
        description: 'S3-compatible file storage with upload, download, and access control. Serves assets through Nginx x-accel-redirect for high-performance delivery.',
        repo: 'https://github.com/shellui/storage-service', featurePage: '/features/storage/',
        tech: ['Python', 'Django', 'S3', 'MinIO', 'x-accel-redirect'] },

      { id: 'admin', x: 620, y: 210, w: 240, label: 'Admin Panel', sub: 'User management · Monitoring · Data overview', category: 'Backend', color: '#3b82f6',
        handlesBottom: true, handlesTop: true,
        description: 'A dedicated admin microfrontend for managing users, monitoring activity, and getting a complete overview of application data.',
        url: 'https://github.com/shellui/shellui-admin', urlLabel: 'Repository', repo: 'https://github.com/shellui/shellui-admin', featurePage: '/features/administration/',
        tech: ['TypeScript', 'Shellui Microfrontend'] },

      { id: 'db', x: 40, y: 400, w: 220, label: 'PostgreSQL / Supabase', sub: 'Users · Sessions · App data', category: 'Infra', color: '#10b981',
        handlesBottom: true, handlesTop: true,
        description: 'Primary data store for users, sessions, and application data. Use Supabase for managed hosting or self-host PostgreSQL.',
        url: 'https://supabase.com', urlLabel: 'supabase.com',
        tech: ['PostgreSQL', 'Supabase', 'SQL'] },

      { id: 'objstore', x: 320, y: 400, w: 220, label: 'S3 / MinIO', sub: 'File buckets · Assets · Uploads', category: 'Infra', color: '#10b981',
        handlesBottom: false, handlesTop: true,
        description: 'S3-compatible object store for file buckets, user uploads, and static assets. MinIO provides a self-hosted alternative.',
        url: 'https://min.io', urlLabel: 'min.io',
        tech: ['S3', 'MinIO', 'Object Storage'] },

      { id: 'nginx', x: 600, y: 400, w: 220, label: 'Nginx / Reverse Proxy', sub: 'Routing · TLS · x-accel-redirect', category: 'Infra', color: '#10b981',
        handlesBottom: true, handlesTop: true,
        description: 'Routes traffic to the shell, backend services, and storage. Handles TLS termination and x-accel-redirect for secure file delivery.',
        url: 'https://hub.docker.com/u/shellui', urlLabel: 'Docker Hub', repo: 'https://github.com/shellui',
        tech: ['Nginx', 'Docker Compose', 'TLS'] },

      { id: 'docs', x: 40, y: 560, w: 180, label: 'Documentation', sub: 'docs.shellui.com', category: 'Tools', color: '#8b5cf6',
        handlesBottom: false, handlesTop: true,
        description: 'Guides, references, and API docs for building with Shellui.',
        url: 'https://docs.shellui.com', urlLabel: 'docs.shellui.com', repo: 'https://github.com/shellui/docs',
        tech: ['Markdown', 'Static Site'] },

      { id: 'playground', x: 260, y: 560, w: 180, label: 'Playground', sub: 'playground.shellui.com', category: 'Tools', color: '#8b5cf6',
        handlesBottom: false, handlesTop: false,
        description: 'Try Shellui in your browser. Experiment with config, themes, and microfrontend loading.',
        url: 'https://playground.shellui.com', urlLabel: 'playground.shellui.com',
        tech: ['Browser-based', 'Live demo'] },

      { id: 'docker', x: 480, y: 560, w: 180, label: 'Docker Images', sub: 'hub.docker.com/u/shellui', category: 'Tools', color: '#8b5cf6',
        handlesBottom: false, handlesTop: true,
        description: 'Pre-built container images for every service. Run the full stack with docker compose up.',
        url: 'https://hub.docker.com/u/shellui', urlLabel: 'Docker Hub',
        tech: ['Docker', 'Docker Compose', 'OCI'] },

      { id: 'github', x: 700, y: 560, w: 180, label: 'GitHub Org', sub: 'github.com/shellui', category: 'Tools', color: '#8b5cf6',
        handlesBottom: false, handlesTop: false,
        description: 'All source code, issues, and discussions. Every service is open-source and welcomes contributions.',
        url: 'https://github.com/shellui', urlLabel: 'github.com/shellui',
        tech: ['Open Source', 'MIT License'] },
    ],

    edges: [
      { from: 'shell', to: 'identity', animated: true },
      { from: 'shell', to: 'storage', animated: true },
      { from: 'shell', to: 'admin', animated: true },
      { from: 'identity', to: 'db', animated: false },
      { from: 'storage', to: 'objstore', animated: false },
      { from: 'admin', to: 'db', animated: false },
      { from: 'admin', to: 'nginx', animated: false },
      { from: 'nginx', to: 'docker', animated: false },
      { from: 'db', to: 'docs', animated: false },
    ],

    init() {
      const rect = this.$refs.canvas.getBoundingClientRect();
      const contentW = 920;
      const scaleToFit = Math.min(rect.width / contentW, 1);
      this.zoom = Math.max(scaleToFit, 0.55);
      this.panX = Math.max(0, (rect.width - contentW * this.zoom) / 2);
      this.panY = 20;
    },

    getNode(id) {
      return this.nodes.find(n => n.id === id);
    },

    nodeCenter(n) {
      const h = this.estimateHeight(n);
      return { x: n.x + n.w / 2, y: n.y + h / 2 };
    },

    estimateHeight(n) {
      return n.repo ? 110 : 95;
    },

    edgePath(e) {
      const from = this.getNode(e.from);
      const to = this.getNode(e.to);
      if (!from || !to) return '';
      const fh = this.estimateHeight(from);
      const th = this.estimateHeight(to);
      const x1 = (from.x + from.w / 2) * this.zoom + this.panX;
      const y1 = (from.y + fh) * this.zoom + this.panY;
      const x2 = (to.x + to.w / 2) * this.zoom + this.panX;
      const y2 = to.y * this.zoom + this.panY;
      const cy = (y1 + y2) / 2;
      return `M ${x1} ${y1} C ${x1} ${cy}, ${x2} ${cy}, ${x2} ${y2}`;
    },

    clientToCanvas(ev) {
      const rect = this.$refs.canvas.getBoundingClientRect();
      return {
        x: (ev.clientX - rect.left - this.panX) / this.zoom,
        y: (ev.clientY - rect.top - this.panY) / this.zoom,
      };
    },

    startDrag(id, e) {
      const ev = e.touches ? e.touches[0] : e;
      const n = this.getNode(id);
      const pt = this.clientToCanvas(ev);
      this.dragging = id;
      this.didDrag = false;
      this.dragOffsetX = pt.x - n.x;
      this.dragOffsetY = pt.y - n.y;
    },

    startPan(e) {
      const ev = e.touches ? e.touches[0] : e;
      this.panning = true;
      this.panStartX = ev.clientX;
      this.panStartY = ev.clientY;
      this.panStartPanX = this.panX;
      this.panStartPanY = this.panY;
    },

    onMouseMove(e) {
      const ev = e.touches ? e.touches[0] : e;
      if (this.dragging) {
        this.didDrag = true;
        const n = this.getNode(this.dragging);
        const pt = this.clientToCanvas(ev);
        n.x = pt.x - this.dragOffsetX;
        n.y = pt.y - this.dragOffsetY;
      } else if (this.panning) {
        this.panX = this.panStartPanX + (ev.clientX - this.panStartX);
        this.panY = this.panStartPanY + (ev.clientY - this.panStartY);
      }
    },

    onTouchMove(e) {
      if (this.dragging || this.panning) {
        e.preventDefault();
        this.onMouseMove(e);
      }
    },

    onMouseUp() {
      this.dragging = null;
      this.panning = false;
    },

    selectNode(id) {
      if (this.didDrag) return;
      this.selected = this.selected === id ? null : id;
    },

    onWheel(e) {
      e.preventDefault();
      const rect = this.$refs.canvas.getBoundingClientRect();
      const mx = e.clientX - rect.left;
      const my = e.clientY - rect.top;
      const delta = e.deltaY > 0 ? 0.95 : 1.05;
      const newZoom = Math.min(Math.max(this.zoom * delta, 0.3), 2);
      this.panX = mx - (mx - this.panX) * (newZoom / this.zoom);
      this.panY = my - (my - this.panY) * (newZoom / this.zoom);
      this.zoom = newZoom;
    },

    zoomIn() { this.zoom = Math.min(this.zoom + 0.15, 2); },
    zoomOut() { this.zoom = Math.max(this.zoom - 0.15, 0.3); },
    resetView() { this.init(); },
  }
}
</script>
