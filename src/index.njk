---
layout: layouts/base.njk
title: Shellui | The web app development platform
description: Shellui is an open-source microfrontend shell. Shared navigation, authentication, administration, and storage wrap your app so you ship the product.
---
    <div class="relative isolate px-4 page-top sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl py-16 sm:py-20">
        {% set latestPost = collections.blog[0] %}
        {% if latestPost %}
          <div class="mb-6 flex justify-center sm:mb-8">
            <div class="relative flex items-center gap-x-3 rounded-full px-3 py-1 text-sm/6 text-gray-600 ring-1 ring-gray-900/10 hover:ring-gray-900/20 dark:text-gray-400 dark:ring-white/10 dark:hover:ring-white/20">
              {{ latestPost.data.heading or latestPost.data.title }}
              <span class="h-4 w-px bg-gray-900/10 dark:bg-white/20" aria-hidden="true"></span>
              <a href="{{ latestPost.url }}" class="font-semibold text-primary-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:text-primary">
                <span class="absolute inset-0" aria-hidden="true"></span>Read the post
              </a>
            </div>
          </div>
        {% endif %}
        <div class="text-center">
          <h1 class="text-5xl font-semibold tracking-tight text-balance text-gray-900 sm:text-6xl lg:text-7xl dark:text-white">
            Build the app, not the infrastructure
          </h1>
          <p class="mt-8 text-lg text-pretty text-gray-600 sm:text-xl/8 dark:text-gray-400">
            Shellui is an open-source microfrontend shell. It wraps your application with shared navigation, authentication, storage, and administration.
          </p>
          <div class="mt-10 flex items-center justify-center gap-x-6">
            <a
              href="{{ site.docs }}"
              class="rounded-md bg-primary px-3.5 py-2.5 text-sm font-semibold text-primary-foreground shadow-xs hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            >
              Read the docs
            </a>
            <a
              href="{{ site.playground }}"
              class="text-sm/6 font-semibold text-gray-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:text-white"
              target="_blank"
              rel="noopener noreferrer"
            >
              Open playground <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </div>

    <section id="features" class="relative z-10 px-4 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="max-w-2xl">
          <h2 class="text-3xl font-semibold tracking-tight text-pretty text-gray-900 sm:text-4xl dark:text-white">
            What the shell owns
          </h2>
          <p class="mt-4 text-lg text-gray-600 dark:text-gray-400">
            Your app runs in an iframe. The host keeps chrome, identity, admin, and files so you do not rebuild them for each product.
          </p>
        </div>

        <a
          href="/features/microfrontend/"
          class="group mt-12 grid overflow-hidden rounded-xl border border-gray-200 bg-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:border-gray-800 dark:bg-gray-900 lg:grid-cols-2"
        >
          <div class="flex flex-col justify-center p-8 sm:p-10 lg:p-12">
            <h3 class="text-2xl font-semibold tracking-tight text-gray-900 sm:text-3xl dark:text-white">
              Microfrontend host
            </h3>
            <p class="mt-4 text-base/7 text-gray-600 dark:text-gray-400">
              Load <code class="rounded bg-gray-100 px-1.5 py-0.5 text-sm dark:bg-gray-800">@shellui/sdk</code>, call <code class="rounded bg-gray-100 px-1.5 py-0.5 text-sm dark:bg-gray-800">init</code>, and talk to the shell over <code class="rounded bg-gray-100 px-1.5 py-0.5 text-sm dark:bg-gray-800">postMessage</code>. Layout, toasts, dialogs, theme, and language stay in <code class="rounded bg-gray-100 px-1.5 py-0.5 text-sm dark:bg-gray-800">shellui.config.ts</code>.
            </p>
            <span class="mt-6 inline-flex items-center text-sm font-medium text-primary-ink group-hover:underline dark:text-primary">
              Explore microfrontend
            </span>
          </div>
          <div class="flex items-center bg-gray-50 p-8 dark:bg-gray-950/60 sm:p-10">
            <div class="mx-auto w-full max-w-md">
              {% include "shell-layout-anim.njk" %}
            </div>
          </div>
        </a>

        <ul class="mt-6 divide-y divide-gray-200 border-y border-gray-200 dark:divide-gray-800 dark:border-gray-800">
          <li>
            <a href="/features/authentication/" class="group flex flex-col gap-1 py-6 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary sm:flex-row sm:items-baseline sm:gap-8">
              <span class="shrink-0 text-base font-semibold text-gray-900 dark:text-white sm:w-44">Authentication</span>
              <span class="min-w-0 text-base/7 text-gray-600 dark:text-gray-400">Sign-in lives in the shell with identity-service or Supabase Auth. Protect routes and issue tokens for people and services.</span>
            </a>
          </li>
          <li>
            <a href="/features/storage/" class="group flex flex-col gap-1 py-6 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary sm:flex-row sm:items-baseline sm:gap-8">
              <span class="shrink-0 text-base font-semibold text-gray-900 dark:text-white sm:w-44">Storage</span>
              <span class="min-w-0 text-base/7 text-gray-600 dark:text-gray-400">A private company bucket with grants, share links, and quotas. Apps call <code class="rounded bg-gray-100 px-1 py-0.5 text-[0.8rem] dark:bg-gray-800">shellui.storage</code>.</span>
            </a>
          </li>
          <li>
            <a href="/features/administration/" class="group flex flex-col gap-1 py-6 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary sm:flex-row sm:items-baseline sm:gap-8">
              <span class="shrink-0 text-base font-semibold text-gray-900 dark:text-white sm:w-44">Administration</span>
              <span class="min-w-0 text-base/7 text-gray-600 dark:text-gray-400">Staff and owners open <code class="rounded bg-gray-100 px-1 py-0.5 text-[0.8rem] dark:bg-gray-800">/admin</code> for users, groups, logs, and tokens. Inject your own sidebar apps from config.</span>
            </a>
          </li>
        </ul>

        <p class="mt-8">
          <a href="/features/" class="text-sm/6 font-semibold text-primary-ink hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:text-primary">
            See all features
          </a>
        </p>
      </div>
    </section>

    <section id="get-started" class="border-t border-gray-200 bg-gray-50 px-4 py-24 sm:px-6 lg:px-8 dark:border-gray-800 dark:bg-gray-900/40">
      <div class="mx-auto max-w-7xl">
        <div class="max-w-2xl">
          <h2 class="text-3xl font-semibold tracking-tight text-pretty text-gray-900 sm:text-4xl dark:text-white">
            Get started
          </h2>
          <p class="mt-4 text-lg text-gray-600 dark:text-gray-400">
            Install the CLI, then follow the docs to configure and run the shell. Or open the playground with no local setup.
          </p>
        </div>
        <div class="mt-12 grid gap-12 lg:grid-cols-2 lg:gap-16">
          <div>
            <h3 class="text-base font-semibold text-gray-900 dark:text-white">Install the CLI</h3>
            <p class="mt-2 text-base/7 text-gray-600 dark:text-gray-400">
              The docs recommend a global <code class="rounded bg-gray-100 px-1.5 py-0.5 text-sm dark:bg-gray-800">@shellui/cli</code>. After that, use <code class="rounded bg-gray-100 px-1.5 py-0.5 text-sm dark:bg-gray-800">shellui</code> to start and build.
            </p>
            <div class="mt-6 max-w-xl">
{% highlight "bash" %}
npm install -g @shellui/cli
{% endhighlight %}
            </div>
            <a
              href="{{ site.docs }}/installation"
              class="mt-6 inline-flex rounded-md bg-primary px-3.5 py-2.5 text-sm font-semibold text-primary-foreground shadow-xs hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            >
              Open installation docs
            </a>
          </div>
          <div>
            <h3 class="text-base font-semibold text-gray-900 dark:text-white">Try it without installing</h3>
            <p class="mt-2 text-base/7 text-gray-600 dark:text-gray-400">
              The playground is a live Shellui app: navigation, sign-in, and the rest of the host chrome.
            </p>
            <a
              href="{{ site.playground }}"
              class="playground-cta mt-6 inline-flex items-center gap-2 text-sm font-semibold text-gray-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:text-white"
              target="_blank"
              rel="noopener noreferrer"
            >
              {% set playgroundIconSize = "size-6" %}
              {% include "playground-app-icon.njk" %}
              Open playground
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    {% include "home-faq.njk" %}
