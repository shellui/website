---
layout: layouts/base.njk
title: Shellui | The web app development platform
description: Shellui is an open-source web app development platform. Navigation, authentication, administration, and storage are built in so your team ships sooner without rebuilding basic features.
ogTitle: Ship sooner without rebuilding basic features
ogDescription: Open-source web app platform with navigation, authentication, administration, and storage built in.
---
{% set agentPrompt = "fetch https://shellui.ai to start with Shellui" %}
<div class="relative isolate overflow-hidden page-top page-x" data-hero-dots>
  <div class="pointer-events-none absolute inset-0 -z-10 bg-linear-to-b from-amber-50 via-white to-white dark:from-amber-500/10 dark:via-gray-950 dark:to-gray-950" aria-hidden="true"></div>
  <canvas class="pointer-events-none absolute inset-0 -z-10 size-full" aria-hidden="true"></canvas>
  <div class="mx-auto max-w-7xl pb-16 sm:pb-20">
  <div class="max-w-3xl" data-hero-text>
        <div class="mb-6 flex sm:mb-8">
          <div class="relative flex items-center gap-x-3 rounded-full bg-white px-3 py-1 text-sm/6 text-gray-600 shadow-xs ring-1 ring-gray-900/10 hover:ring-gray-900/20 dark:bg-gray-900 dark:text-gray-400 dark:ring-white/10 dark:hover:ring-white/20">
            v{{ productVersion }} is out
            <span class="h-4 w-px bg-gray-900/10 dark:bg-white/20" aria-hidden="true"></span>
            <a href="/changelog/" class="font-semibold text-primary-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
              <span class="absolute inset-0" aria-hidden="true"></span>Read the changelog
            </a>
          </div>
        </div>
    <h1 class="text-5xl font-semibold tracking-tight text-balance text-gray-900 sm:text-6xl lg:text-7xl dark:text-white">Ship sooner without rebuilding basic features</h1>
    <p class="mt-6 text-lg text-pretty text-gray-600 sm:text-xl/8 dark:text-gray-400">Shellui is an open-source web app platform with navigation, authentication, administration, and storage built in. Your product stays center stage, and your team skips rebuilding the basics.</p>
  </div>
    <div class="mt-10 flex flex-col gap-4 lg:flex-row lg:items-center">
      <div class="flex items-center gap-x-4">
          <a href="{{ site.docs }}/quickstart" class="rounded-md bg-primary px-3.5 py-2.5 text-sm font-semibold text-primary-foreground shadow-xs hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">Get started</a>
          <a href="/request-a-demo/" class="rounded-md bg-white px-3.5 py-2.5 text-sm font-semibold text-gray-900 shadow-xs ring-1 ring-gray-300 ring-inset hover:bg-gray-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:bg-white/5 dark:text-white dark:ring-white/10 dark:hover:bg-white/10">Request a demo</a>
      </div>
      <div class="agent-prompt flex h-11 w-full min-w-0 items-center overflow-hidden rounded-md border border-gray-200 bg-white shadow-xs lg:w-auto dark:border-gray-800 dark:bg-gray-900">
        <span class="hidden h-full shrink-0 items-center border-r border-gray-200 px-3 sm:flex dark:border-gray-800" title="Works with your agent">{% include "agent-marks.njk" %}</span>
        <p class="min-w-0 flex-1 truncate px-3 font-mono text-sm text-gray-900 select-all dark:text-gray-50" title="{{ agentPrompt }}">{{ agentPrompt }}</p>
        <button
          type="button"
          class="copy-btn inline-flex h-full w-11 shrink-0 cursor-pointer items-center justify-center border-l border-gray-200 text-gray-600 hover:bg-gray-50 hover:text-gray-900 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-primary dark:border-gray-800 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-white"
          data-copy="{{ agentPrompt }}"
          aria-label="Copy agent prompt"
          onclick="window.shelluiCopyPrompt && window.shelluiCopyPrompt(this)"
        >
          <svg class="copy-icon size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
          <svg class="check-icon size-4 text-primary-ink" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
        </button>
      </div>
      <p class="sr-only" data-copy-status aria-live="polite"></p>
    </div>
    <p class="mt-4 text-sm text-gray-500 dark:text-gray-400">Free and MIT licensed. Self-host it today.</p>
  </div>
</div>

    {% include "home-bento.njk" %}

    {% include "home-init.njk" %}

    {% include "home-config.njk" %}

    {% include "home-deploy.njk" %}

    <section id="audience" class="border-t border-gray-200 page-x py-24 dark:border-gray-800">
      <div class="mx-auto max-w-7xl">
        <div class="max-w-2xl">
          <h2 class="text-3xl font-semibold tracking-tight text-pretty text-gray-900 sm:text-4xl dark:text-white">
            Same shell as you grow
          </h2>
          <p class="mt-4 text-lg text-gray-600 dark:text-gray-400">
            MIT license, one CLI, one static build. Optional native desktop from the same project. The host does not fork when a second surface or a second team shows up.
          </p>
        </div>
        <dl class="mt-12 max-w-3xl space-y-8">
          <div class="sm:grid sm:grid-cols-[10rem_minmax(0,1fr)] sm:gap-8">
            <dt class="text-base font-semibold text-gray-900 dark:text-white">Shared chrome</dt>
            <dd class="mt-1 text-base/7 text-gray-600 sm:mt-0 dark:text-gray-400">Several frontends, one product shell. Each surface keeps its own stack.</dd>
          </div>
          <div class="sm:grid sm:grid-cols-[10rem_minmax(0,1fr)] sm:gap-8">
            <dt class="text-base font-semibold text-gray-900 dark:text-white">Host extras</dt>
            <dd class="mt-1 text-base/7 text-gray-600 sm:mt-0 dark:text-gray-400">Navigation, auth, admin, and files ship with the shell so your app stays the product.</dd>
          </div>
          <div class="sm:grid sm:grid-cols-[10rem_minmax(0,1fr)] sm:gap-8">
            <dt class="text-base font-semibold text-gray-900 dark:text-white">Yours to run</dt>
            <dd class="mt-1 text-base/7 text-gray-600 sm:mt-0 dark:text-gray-400">Build static files, host them where you already ship, or distribute the output yourself.</dd>
          </div>
          <div class="sm:grid sm:grid-cols-[10rem_minmax(0,1fr)] sm:gap-8">
            <dt class="flex items-center gap-2 text-base font-semibold text-gray-900 dark:text-white">
              {% set tauriIconClass = "size-4" %}
              {% include "tauri-icon.njk" %}
              Native desktop
            </dt>
            <dd class="mt-1 text-base/7 text-gray-600 sm:mt-0 dark:text-gray-400">
              <code class="rounded bg-gray-100 px-1 py-0.5 text-[0.8rem] dark:bg-gray-800">shellui build --app</code> wraps the same shell with Tauri 2. See
              <a href="/features/web-and-desktop/#desktop" class="font-medium text-primary-ink hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">Features</a>
              and the
              <a href="{{ site.docs }}/tauri/" class="font-medium text-primary-ink hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">desktop docs</a>.
            </dd>
          </div>
        </dl>
        <p class="mt-12 text-sm/6 text-gray-500 dark:text-gray-400">
          <a href="/architecture/" class="font-medium text-primary-ink hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">Architecture</a>
          ·
          <a href="{{ site.docs }}" class="font-medium text-primary-ink hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">Documentation</a>
          ·
          <a href="/changelog/" class="font-medium text-primary-ink hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">Changelog for {{ productVersion }}</a>
        </p>
      </div>
    </section>

    {% if site.newsletter.key %}
      <section id="newsletter" class="border-t border-gray-200 page-x py-24 dark:border-gray-800">
        <div class="mx-auto max-w-7xl">
          {% set newsletterVariant = "details" %}
          {% set newsletterId = "home-newsletter" %}
          {% include "newsletter-signup.njk" %}
        </div>
      </section>
    {% endif %}

<script src="/assets/js/hero-dots.js" type="module"></script>
