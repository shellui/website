.dark .mi{--bg:#030712;--dot:#1A2130;--win:#0A0F1C;--ln:rgba(255,255,255,.1);--wf:#1A2232;--ink:#F9FAFB;--mut:#9CA3AF;--side:#0D1322;--sh:.35}
.mi .bg{fill:var(--bg)}.mi .dot{fill:var(--dot)}.mi .win{fill:var(--win);stroke:var(--ln);stroke-width:2}.mi .side{fill:var(--side)}.mi .wf{fill:var(--wf)}.mi .ln{fill:var(--ln)}
.mi .card{fill:var(--win);stroke:var(--mut);stroke-opacity:.45;stroke-width:2;stroke-dasharray:8 6}
.mi .t{font-family:var(--font-sans,Inter);font-weight:650;fill:var(--ink)}
.mi .m{font-family:"IBM Plex Mono",ui-monospace,Menlo,monospace;font-weight:600;fill:var(--pk)}
.mi .ink{fill:var(--ink)}.mi .gd{fill:var(--pr)}.mi .gf{fill:var(--pf)}
.mi .fr{fill:none;stroke:var(--pr);stroke-width:2.5;stroke-dasharray:9 6}
.mi .ld{fill:none;stroke:var(--pr);stroke-width:2.5;stroke-dasharray:6 7;stroke-linecap:round}
.mi .pill{fill:var(--win);stroke:var(--pr);stroke-width:2;stroke-dasharray:6 4}
.mi .shf{flood-color:#000;flood-opacity:var(--sh)}
@media (prefers-reduced-motion:no-preference){
.mi .flow{animation:mi-flow 1.2s linear infinite}
.mi .pk1{animation:mi-drop 9s cubic-bezier(.32,.72,0,1) infinite both}
.mi .sl{animation:mi-fill 9s ease infinite both}
.mi .bd{animation:mi-badge 9s ease infinite both}
}
