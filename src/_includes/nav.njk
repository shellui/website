{% set featuresActive = page.url and page.url.slice(0, 10) == '/features/' %}
{% set developersActive = page.url == '/architecture/' or page.url == '/roadmap/' or page.url == '/changelog/' %}

{% macro navIcon(name) %}
  {% if name == 'layout' %}
    <svg class="size-5" viewBox="0 0 1080 1080" aria-hidden="true">
      <use href="#logo-shellui-mark" />
    </svg>
  {% elif name == 'lock' %}
    <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
    </svg>
  {% elif name == 'storage' %}
    <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01" />
    </svg>
  {% elif name == 'cog' %}
    <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
    </svg>
  {% elif name == 'book' %}
    <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
    </svg>
  {% elif name == 'cube' %}
    <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
    </svg>
  {% elif name == 'map' %}
    <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l5.447 2.724A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
    </svg>
  {% elif name == 'list' %}
    <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
    </svg>
  {% endif %}
{% endmacro %}

<header
  class="fixed inset-x-0 top-0 z-50"
  x-data="{ mobileOpen: false, featuresOpen: false, developersOpen: false, flyTimer: null, mFeaturesOpen: true, mDevelopersOpen: true }"
  @keydown.escape.window="mobileOpen = false; featuresOpen = false; developersOpen = false"
  @resize.window="if (window.innerWidth >= 1024) mobileOpen = false"
  x-effect="document.documentElement.classList.toggle('overflow-hidden', mobileOpen); document.body.classList.toggle('overflow-hidden', mobileOpen)"
>
  <div
    x-show="mobileOpen"
    x-cloak
    x-transition:enter="transition ease-out duration-200 motion-reduce:transition-none"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="transition ease-in duration-150 motion-reduce:transition-none"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    class="fixed inset-x-0 top-16 bottom-0 z-40 bg-gray-950/40 backdrop-blur-[2px] lg:hidden dark:bg-black/55"
    @click="mobileOpen = false"
    aria-hidden="true"
  ></div>

  <div class="relative z-50 border-b border-gray-200/50 bg-white/80 backdrop-blur-md dark:border-gray-800/50 dark:bg-gray-950/80">
    <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:grid lg:grid-cols-[1fr_auto_1fr] lg:px-8" aria-label="Global">
      <div class="flex lg:justify-self-start">
        <a href="/" class="inline-flex items-center" aria-label="shellui">
          {% include "logo.njk" %}
        </a>
      </div>

      <div class="hidden lg:flex lg:items-center lg:justify-center lg:gap-x-8 lg:justify-self-center">
        <div
          class="relative"
          @mouseenter="clearTimeout(flyTimer); developersOpen = false; featuresOpen = true"
          @mouseleave="flyTimer = setTimeout(() => featuresOpen = false, 75)"
        >
          <button
            type="button"
            class="inline-flex items-center gap-x-1 text-sm font-medium {% if featuresActive %}text-gray-900 dark:text-white{% else %}text-gray-600 transition-colors hover:text-gray-900 dark:text-gray-400 dark:hover:text-white{% endif %}"
            {% if featuresActive %}aria-current="page"{% endif %}
            :aria-expanded="featuresOpen.toString()"
          >
            Features
            <svg class="size-4 flex-none text-gray-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
            </svg>
          </button>
          <div
            x-show="featuresOpen"
            x-cloak
            x-transition:enter="transition ease-out duration-100"
            x-transition:enter-start="translate-y-1 opacity-0"
            x-transition:enter-end="translate-y-0 opacity-100"
            x-transition:leave="transition ease-in duration-75"
            x-transition:leave-start="translate-y-0 opacity-100"
            x-transition:leave-end="translate-y-1 opacity-0"
            class="absolute left-0 z-10 mt-2 w-screen max-w-sm -translate-x-[50px] overflow-hidden rounded-2xl bg-white shadow-lg ring-1 ring-gray-900/5 dark:bg-gray-900 dark:ring-white/10 dark:shadow-none"
          >
            <div class="p-2">
              {% for item in nav.features %}
                <div class="group relative flex gap-x-4 rounded-xl p-3 hover:bg-gray-50 dark:hover:bg-gray-800/50">
                  <div class="flex size-10 flex-none items-center justify-center rounded-lg bg-gray-50 text-primary-ink group-hover:bg-white dark:bg-gray-800/50 dark:text-primary dark:group-hover:bg-gray-800">
                    {{ navIcon(item.icon) }}
                  </div>
                  <div class="min-w-0 flex-1">
                    <a href="{{ item.href }}" class="font-semibold text-gray-900 dark:text-white">
                      {{ item.label }}
                      <span class="absolute inset-0"></span>
                    </a>
                    <p class="mt-0.5 text-sm text-gray-600 dark:text-gray-400">{{ item.description }}</p>
                  </div>
                </div>
              {% endfor %}
            </div>
          </div>
        </div>

        <div
          class="relative"
          @mouseenter="clearTimeout(flyTimer); featuresOpen = false; developersOpen = true"
          @mouseleave="flyTimer = setTimeout(() => developersOpen = false, 75)"
        >
          <button
            type="button"
            class="inline-flex items-center gap-x-1 text-sm font-medium {% if developersActive %}text-gray-900 dark:text-white{% else %}text-gray-600 transition-colors hover:text-gray-900 dark:text-gray-400 dark:hover:text-white{% endif %}"
            {% if developersActive %}aria-current="page"{% endif %}
            :aria-expanded="developersOpen.toString()"
          >
            Developers
            <svg class="size-4 flex-none text-gray-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
            </svg>
          </button>
          <div
            x-show="developersOpen"
            x-cloak
            x-transition:enter="transition ease-out duration-100"
            x-transition:enter-start="translate-y-1 opacity-0"
            x-transition:enter-end="translate-y-0 opacity-100"
            x-transition:leave="transition ease-in duration-75"
            x-transition:leave-start="translate-y-0 opacity-100"
            x-transition:leave-end="translate-y-1 opacity-0"
            class="absolute left-0 z-10 mt-2 w-screen max-w-sm -translate-x-[50px] overflow-hidden rounded-2xl bg-white shadow-lg ring-1 ring-gray-900/5 dark:bg-gray-900 dark:ring-white/10 dark:shadow-none"
          >
            <div class="p-2">
              {% for item in nav.developers %}
                <div class="group relative flex gap-x-4 rounded-xl p-3 hover:bg-gray-50 dark:hover:bg-gray-800/50">
                  <div class="flex size-10 flex-none items-center justify-center rounded-lg bg-gray-50 text-primary-ink group-hover:bg-white dark:bg-gray-800/50 dark:text-primary dark:group-hover:bg-gray-800">
                    {{ navIcon(item.icon) }}
                  </div>
                  <div class="min-w-0 flex-1">
                    <a href="{{ item.href }}" class="font-semibold text-gray-900 dark:text-white">
                      {{ item.label }}
                      <span class="absolute inset-0"></span>
                    </a>
                    <p class="mt-0.5 text-sm text-gray-600 dark:text-gray-400">{{ item.description }}</p>
                  </div>
                </div>
              {% endfor %}
            </div>
          </div>
        </div>

        {% for item in [
          { href: "/pricing/", label: "Pricing" },
          { href: site.docs, label: "Docs" },
          { href: "/blog/", label: "Blog" }
        ] %}
          <a
            href="{{ item.href }}"
            class="text-sm font-medium {% if page.url == item.href %}text-gray-900 dark:text-white{% else %}text-gray-600 transition-colors hover:text-gray-900 dark:text-gray-400 dark:hover:text-white{% endif %}"
            {% if page.url == item.href %}aria-current="page"{% endif %}
          >{{ item.label }}</a>
        {% endfor %}
      </div>

      <div class="flex flex-1 items-center justify-end gap-x-2 lg:flex-none lg:justify-self-end">
        <button
          type="button"
          class="theme-toggle hidden rounded-lg p-2 text-gray-600 transition-colors hover:bg-gray-100 hover:text-gray-900 lg:inline-flex dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-white"
          aria-label="Toggle dark mode"
        >
          <svg class="h-5 w-5 dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <svg class="hidden h-5 w-5 dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>

        <button
          type="button"
          class="inline-flex size-10 items-center justify-center rounded-lg text-gray-600 transition-colors hover:bg-gray-100 hover:text-gray-900 lg:hidden dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-white"
          :aria-expanded="mobileOpen.toString()"
          aria-controls="mobile-menu"
          @click="mobileOpen = !mobileOpen; featuresOpen = false; developersOpen = false"
        >
          <span class="sr-only" x-text="mobileOpen ? 'Close main menu' : 'Open main menu'">Open main menu</span>
          <span class="nav-burger" :class="mobileOpen && 'is-open'" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </span>
        </button>
      </div>
    </nav>
  </div>

  <div
    id="mobile-menu"
    class="relative z-50 lg:hidden"
    x-show="mobileOpen"
    x-cloak
    x-transition:enter="transition ease-out duration-200 motion-reduce:transition-none"
    x-transition:enter-start="-translate-y-2 opacity-0"
    x-transition:enter-end="translate-y-0 opacity-100"
    x-transition:leave="transition ease-in duration-150 motion-reduce:transition-none"
    x-transition:leave-start="translate-y-0 opacity-100"
    x-transition:leave-end="-translate-y-2 opacity-0"
    role="dialog"
    aria-modal="true"
    aria-label="Main menu"
  >
    <div class="flex max-h-[calc(100dvh-4rem)] flex-col overflow-hidden rounded-b-3xl border-b border-gray-200/80 bg-white shadow-2xl shadow-gray-950/15 dark:border-gray-800/80 dark:bg-gray-950 dark:shadow-black/40">
      <div class="min-h-0 flex-1 overflow-y-auto overscroll-contain px-3 py-3 sm:px-4">
        <div>
          <button
            type="button"
            class="flex w-full items-center justify-between rounded-xl px-3 py-2 text-xs font-semibold tracking-wider text-gray-400 uppercase hover:bg-gray-50 dark:text-gray-500 dark:hover:bg-gray-800/50"
            @click="mFeaturesOpen = !mFeaturesOpen"
            :aria-expanded="mFeaturesOpen.toString()"
          >
            Features
            <svg class="size-4 text-gray-400 transition-transform duration-200 motion-reduce:transition-none" :class="mFeaturesOpen && 'rotate-180'" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
            </svg>
          </button>
          <div
            class="grid transition-[grid-template-rows] duration-200 ease-out motion-reduce:transition-none"
            :class="mFeaturesOpen ? 'grid-rows-[1fr]' : 'grid-rows-[0fr]'"
            :inert="!mFeaturesOpen"
          >
            <div class="min-h-0 overflow-hidden">
              <div class="space-y-0.5 pt-1">
                {% for item in nav.features %}
                  <a
                    href="{{ item.href }}"
                    class="group flex gap-x-3 rounded-xl p-3 {% if page.url == item.href %}bg-gray-100 dark:bg-gray-800/80{% else %}hover:bg-gray-50 dark:hover:bg-gray-800/50{% endif %}"
                    {% if page.url == item.href %}aria-current="page"{% endif %}
                    @click="mobileOpen = false"
                  >
                    <div class="flex size-10 flex-none items-center justify-center rounded-lg bg-gray-50 text-primary-ink group-hover:bg-white dark:bg-gray-800/50 dark:text-primary dark:group-hover:bg-gray-800">
                      {{ navIcon(item.icon) }}
                    </div>
                    <div class="min-w-0 flex-1">
                      <p class="font-semibold text-gray-900 dark:text-white">{{ item.label }}</p>
                      <p class="mt-0.5 text-sm text-gray-600 dark:text-gray-400">{{ item.description }}</p>
                    </div>
                  </a>
                {% endfor %}
                <a
                  href="/features/"
                  class="flex items-center justify-between rounded-xl px-3 py-3 text-sm font-semibold {% if page.url == '/features/' %}bg-gray-100 text-primary-ink dark:bg-gray-800/80 dark:text-primary{% else %}text-primary-ink hover:bg-gray-50 dark:text-primary dark:hover:bg-gray-800/50{% endif %}"
                  {% if page.url == '/features/' %}aria-current="page"{% endif %}
                  @click="mobileOpen = false"
                >
                  View all features
                  <svg class="size-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M7.22 14.78a.75.75 0 0 1 0-1.06L10.94 10 7.22 6.28a.75.75 0 0 1 1.06-1.06l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0Z" clip-rule="evenodd" />
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-2">
          <button
            type="button"
            class="flex w-full items-center justify-between rounded-xl px-3 py-2 text-xs font-semibold tracking-wider text-gray-400 uppercase hover:bg-gray-50 dark:text-gray-500 dark:hover:bg-gray-800/50"
            @click="mDevelopersOpen = !mDevelopersOpen"
            :aria-expanded="mDevelopersOpen.toString()"
          >
            Developers
            <svg class="size-4 text-gray-400 transition-transform duration-200 motion-reduce:transition-none" :class="mDevelopersOpen && 'rotate-180'" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
            </svg>
          </button>
          <div
            class="grid transition-[grid-template-rows] duration-200 ease-out motion-reduce:transition-none"
            :class="mDevelopersOpen ? 'grid-rows-[1fr]' : 'grid-rows-[0fr]'"
            :inert="!mDevelopersOpen"
          >
            <div class="min-h-0 overflow-hidden">
              <div class="space-y-0.5 pt-1">
                {% for item in nav.developers %}
                  <a
                    href="{{ item.href }}"
                    class="group flex gap-x-3 rounded-xl p-3 {% if page.url == item.href %}bg-gray-100 dark:bg-gray-800/80{% else %}hover:bg-gray-50 dark:hover:bg-gray-800/50{% endif %}"
                    {% if page.url == item.href %}aria-current="page"{% endif %}
                    @click="mobileOpen = false"
                  >
                    <div class="flex size-10 flex-none items-center justify-center rounded-lg bg-gray-50 text-primary-ink group-hover:bg-white dark:bg-gray-800/50 dark:text-primary dark:group-hover:bg-gray-800">
                      {{ navIcon(item.icon) }}
                    </div>
                    <div class="min-w-0 flex-1">
                      <p class="font-semibold text-gray-900 dark:text-white">{{ item.label }}</p>
                      <p class="mt-0.5 text-sm text-gray-600 dark:text-gray-400">{{ item.description }}</p>
                    </div>
                  </a>
                {% endfor %}
              </div>
            </div>
          </div>
        </div>

        <div class="mt-3 border-t border-gray-200/80 pt-2 dark:border-gray-800/80">
          {% for item in [
            { href: "/pricing/", label: "Pricing" },
            { href: site.docs, label: "Docs" },
            { href: "/blog/", label: "Blog" }
          ] %}
            <a
              href="{{ item.href }}"
              class="flex items-center justify-between rounded-xl px-3 py-3 text-base font-medium {% if page.url == item.href %}bg-gray-100 text-gray-900 dark:bg-gray-800/80 dark:text-white{% else %}text-gray-700 hover:bg-gray-50 dark:text-gray-200 dark:hover:bg-gray-800/50{% endif %}"
              {% if page.url == item.href %}aria-current="page"{% endif %}
              @click="mobileOpen = false"
            >
              {{ item.label }}
              <svg class="size-4 text-gray-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M7.22 14.78a.75.75 0 0 1 0-1.06L10.94 10 7.22 6.28a.75.75 0 0 1 1.06-1.06l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0Z" clip-rule="evenodd" />
              </svg>
            </a>
          {% endfor %}
        </div>
      </div>
      <div class="shrink-0 border-t border-gray-200/80 px-3 pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] sm:px-4 dark:border-gray-800/80">
        <button
          type="button"
          class="theme-toggle flex w-full items-center gap-3 rounded-xl px-3 py-3 text-base font-medium text-gray-700 transition-colors hover:bg-gray-50 dark:text-gray-200 dark:hover:bg-gray-800/50"
          aria-label="Toggle dark mode"
        >
          <span class="flex size-10 items-center justify-center rounded-lg bg-gray-50 text-gray-700 dark:bg-gray-800/50 dark:text-gray-200">
            <svg class="size-5 dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
            <svg class="hidden size-5 dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
            </svg>
          </span>
          <span class="dark:hidden">Dark mode</span>
          <span class="hidden dark:inline">Light mode</span>
        </button>
      </div>
    </div>
  </div>
</header>
