{#- Interactive layouts piece. Matches the shell layouts shipped in Shellui 0.7 (gold active pill, app bar underline, inset cards, glass floating panel, windows desktop with a calm dot field and a glass taskbar). Colours come from site variables only. -#}
{%- set ico = {
  side: '<svg viewBox="0 0 16 16" aria-hidden="true"><rect x="2" y="2.5" width="12" height="11" rx="2"/><path d="M6 2.5v11"/></svg>',
  gear: '<svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="2.2"/><path d="M8 1.8v1.6M8 12.6v1.6M1.8 8h1.6M12.6 8h1.6M3.6 3.6l1.1 1.1M11.3 11.3l1.1 1.1M3.6 12.4l1.1-1.1M11.3 4.7l1.1-1.1"/></svg>',
  max: '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 6V3h3M10 3h3v3M13 10v3h-3M6 13H3v-3"/></svg>',
  close: '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8"/></svg>',
  ext: '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5 11l6-6M6 5h5v5"/></svg>',
  caret: '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 6.5L8 10l3.5-3.5"/></svg>'
} -%}
<div class="lyx" data-layouts data-dots>
  <canvas class="lyx-dots" aria-hidden="true"></canvas>
  <div class="lyx-top">
  <div class="lyx-seg" role="tablist" aria-label="Shellui layouts">
    <span class="lyx-pill" aria-hidden="true"></span>
    {% for l in shellLayouts %}
      <button type="button" role="tab" id="lyx-tab-{{ l.id }}" aria-controls="lyx-stage" aria-selected="{{ 'true' if loop.first else 'false' }}" tabindex="{{ '0' if loop.first else '-1' }}" data-layout="{{ l.id }}">{{ l.name }}{% if l.experimental %}<span class="lyx-exp">Experimental</span>{% endif %}</button>
    {% endfor %}
  </div>
  <button type="button" class="anim-play lyx-play" aria-label="Pause layout tour" data-layout-play>
    <svg viewBox="0 0 40 40" aria-hidden="true"><circle class="anim-ring" cx="20" cy="20" r="19"/><circle class="anim-ring-fill" cx="20" cy="20" r="19" pathLength="100"/><path class="anim-icon" d="M15 13.5h3.5v13H15zM21.5 13.5H25v13h-3.5z"/></svg>
  </button>
  </div>
  <div class="lyx-fit">
    <div class="lyx-wrap">
      <div class="lyx-stage" id="lyx-stage" role="tabpanel" aria-labelledby="lyx-tab-sidebar" data-l="sidebar">
        <div class="lyx-desk" data-dots data-dots-calm aria-hidden="true"><canvas></canvas></div>
        <div class="lyx-a lyx-win2" aria-hidden="true"><div class="lyx-tb2"><span class="lyx-tile"></span>Toaster<span class="lyx-ctl">{{ ico.max | safe }}{{ ico.close | safe }}</span></div><div class="lyx-ct" style="padding:18px"><div class="lyx-sk" style="width:60%"></div><div class="lyx-sk" style="width:85%;height:8px;margin-top:10px"></div><div class="lyx-btn">Show toast</div></div></div>
        <div class="lyx-a lyx-main">
          <div class="lyx-art" aria-hidden="true"><span></span><span></span><span></span></div>
          <div class="lyx-tb" aria-hidden="true"><span class="lyx-tile"></span>Layout<span class="lyx-ctl">{{ ico.max | safe }}{{ ico.close | safe }}</span></div>
          <div class="lyx-ct">
            <p class="lyx-h">Layout</p>
            <p class="lyx-p">Pick sidebar, sidebar-inset, app-bar, app-bar-inset, floating, fullscreen, or windows in shellui.config.json.</p>
            <div class="lyx-cards" aria-hidden="true">
              {% for l in shellLayouts %}{% if not l.experimental %}
                <div class="lyx-cd" data-c="{{ l.id }}"><div class="lyx-th">{% for t in l.thumb %}<b style="left:{{ t[0] }}px;top:{{ t[1] }}px;width:{{ t[2] }}px;height:{{ t[3] }}px"></b>{% endfor %}</div>{{ l.name }}</div>
              {% endif %}{% endfor %}
            </div>
          </div>
        </div>
        <div class="lyx-a lyx-side" aria-hidden="true">
          <div class="lyx-sh"><span class="lyx-logo"></span><span class="lyx-ib">{{ ico.side | safe }}</span></div>
          <div class="lyx-nav">
            <div class="lyx-cap">Features</div><div class="lyx-ni"><i></i>Dialog</div><div class="lyx-ni"><i></i>Toaster</div><div class="lyx-ni"><i></i>Modal and drawer</div><div class="lyx-ni on"><i></i>Layout</div>
            <div class="lyx-cap">Preferences</div><div class="lyx-ni"><i></i>Themes</div><div class="lyx-ni"><i></i>Language and region</div>
            <div class="lyx-ni lyx-gap"><i></i>Docs<span class="lyx-ext">{{ ico.ext | safe }}</span></div>
          </div>
          <div class="lyx-foot"><div class="lyx-ni"><span class="lyx-gear">{{ ico.gear | safe }}</span>Settings</div></div>
        </div>
        <div class="lyx-a lyx-bar" aria-hidden="true"><span class="lyx-logo"></span><span class="lyx-bi">Homepage</span><span class="lyx-bi on">Features</span><span class="lyx-bi">Preferences<span class="lyx-caret">{{ ico.caret | safe }}</span></span><span class="lyx-bi">Docs<span class="lyx-ext">{{ ico.ext | safe }}</span></span><span class="lyx-ib lyx-end">{{ ico.gear | safe }}</span></div>
        <div class="lyx-a lyx-task" aria-hidden="true"><span class="lyx-start"><span class="lyx-logo"></span>Shellui</span><span class="lyx-tk on"><span class="lyx-tile"></span>Layout</span><span class="lyx-tk open"><span class="lyx-tile"></span>Toaster</span><span class="lyx-tray"><span class="lyx-tk"><span class="lyx-gear">{{ ico.gear | safe }}</span>Settings</span><span class="lyx-clock">10:22<small>Tue, Oct 27</small></span></span></div>
      </div>
      <div class="lyx-badges" aria-hidden="true"></div>
    </div>
  </div>
  <p class="lyx-code"><span class="lyx-file">shellui.config.json</span> { "layout": "<b data-layout-value>sidebar</b>" }</p>
  <script type="application/json" data-layout-badges>{{ shellLayouts | dump | safe }}</script>
</div>
