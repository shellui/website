{# Docs and related links for a feature page. Pass featureDocs as a list of { href, label }. #}
<nav class="mt-16 max-w-3xl border-t border-border pt-10" aria-label="Docs and related pages">
  <h2 class="text-base font-semibold text-foreground">Docs and related pages</h2>
  <ul class="mt-4 flex flex-wrap gap-x-4 gap-y-2 text-sm">
    {% for item in featureDocs %}
      <li>
        <a
          class="font-medium text-primary-ink underline underline-offset-2 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:text-primary"
          href="{{ item.href }}"
          {% if item.external %}target="_blank" rel="noopener noreferrer"{% endif %}
        >{{ item.label }}</a>
      </li>
    {% endfor %}
  </ul>
</nav>
