{#- Homepage feature bento. Visuals are inline SVG using currentColor and --color-primary; hover/focus motion lives in bento.css. -#}
{% set tiles = [
  { id: "shell", href: "/features/apps-and-navigation/", span: "md:col-span-2 lg:row-span-2", title: "One shell for all your apps", text: "Combine apps built with different frameworks under shared navigation, dialogs, and settings." },
  { id: "auth", href: "/features/authentication/", span: "md:col-span-2", title: "Sign-in included", text: "OAuth and magic links across every app, with the pages you choose behind a session." },
  { id: "sso", href: "/features/authentication/", span: "", title: "SAML SSO and SCIM", text: "Register identity providers per company and provision members with SCIM." },
  { id: "storage", href: "/features/storage/", span: "", title: "File storage", text: "Upload, share, and limit files through the SDK." },
  { id: "email", href: "/features/email/", span: "md:col-span-2", title: "Email and newsletters", text: "Themed sign-in mail, event mail, and newsletters, sent with Resend, Amazon SES, or SMTP." },
  { id: "hooks", href: "/features/administration/", span: "", title: "Email and webhook rules", text: "Pick what each event does: send an email, call a webhook, or both." },
  { id: "admin", href: "/features/administration/", span: "", title: "Administration", text: "Members, email, webhooks, and company access in one panel." },
  { id: "desktop", href: "/features/web-and-desktop/", span: "", title: "Web and desktop", text: "Build static web files or a Tauri 2 desktop app from one project." },
  { id: "oss", href: site.github, span: "md:col-span-2", title: "Open source, yours to run", text: "MIT licensed. Self-host every service, and give your agent shellui.ai to start." },
  { id: "audit", href: "/features/administration/", span: "", title: "Audit and privacy", text: "Event logs, per-company metrics, and no sign-in links in webhooks or logs." }
] %}
<section id="features" class="bento relative z-10 page-x py-24">
  <svg width="0" height="0" class="absolute" aria-hidden="true"><defs>
    <filter id="bento-sh" x="-20%" y="-20%" width="140%" height="160%"><feDropShadow dx="0" dy="3" stdDeviation="4" class="shf"/></filter>
  </defs></svg>
  <div class="mx-auto max-w-7xl">
    <div class="max-w-2xl">
      <h2 class="text-3xl font-semibold tracking-tight text-pretty text-gray-900 sm:text-4xl dark:text-white">Everything around your app, already built</h2>
      <p class="mt-4 text-lg text-gray-600 dark:text-gray-400">Start with sign-in, files, email, and admin on day one. Add SSO, audit trails, and company controls when a larger team arrives.</p>
    </div>
    <ul class="mt-12 grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4">
      {% for t in tiles %}
      <li class="{{ t.span }}">
        <a href="{{ t.href }}" class="bento-tile group flex h-full flex-col overflow-hidden rounded-xl border border-gray-200 bg-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:border-gray-800 dark:bg-gray-900">
          <div class="bento-art relative flex-1 border-b border-gray-200 dark:border-gray-800">
            {% if t.id == "shell" %}
            <div class="av4-hov h-full bg-gray-100 dark:bg-gray-950 lg:absolute lg:inset-0 lg:flex lg:items-center">{% set avBare = true %}{% include "apps-visual-responsive.njk" %}</div>
            {% elif t.id == "auth" %}
            {% include "auth-bento.njk" %}
            {% elif t.id == "sso" %}
            <div class="h-40 w-full">{% include "sync-bento-v3.njk" %}</div>
            {% elif t.id == "email" %}
            {% include "email-bento.njk" %}
            {% elif t.id == "hooks" %}
            {% include "email-webhooks-bento.njk" %}
            {% else %}
            <svg class="bv bv-{{ t.id }} block h-40 w-full py-3" viewBox="0 0 200 110"  aria-hidden="true">
              {% if false %}
              {% elif t.id == "storage" %}
              <path d="M52 42h30l7 8h59v44H52z" class="w2"/><path d="M52 52h96v42H52z" class="c"/>
              <g class="bv-a"><rect x="86" y="12" width="28" height="36" rx="3" class="c"/><rect x="92" y="20" width="16" height="3" rx="1.5" class="w"/><rect x="92" y="27" width="11" height="3" rx="1.5" class="w"/><rect x="92" y="37" width="16" height="5" rx="2.5" class="g"/></g>
              {% elif t.id == "admin" %}
              <rect x="30" y="16" width="140" height="80" rx="6" class="c"/><rect x="30" y="16" width="38" height="80" rx="6" class="w2"/>
              <rect x="38" y="28" width="22" height="4" rx="2" class="w"/><rect x="38" y="38" width="22" height="4" rx="2" class="w"/><rect x="38" y="48" width="22" height="4" rx="2" class="w"/>
              <rect class="bv-a g" x="78" y="26" width="82" height="12" rx="3"/><rect x="78" y="48" width="70" height="5" rx="2.5" class="w"/><rect x="78" y="60" width="56" height="5" rx="2.5" class="w"/><rect x="78" y="72" width="64" height="5" rx="2.5" class="w"/>
              {% elif t.id == "desktop" %}
              <rect x="24" y="18" width="96" height="62" rx="6" class="c"/><rect x="64" y="80" width="16" height="12" class="w2"/><rect x="52" y="90" width="40" height="5" rx="2.5" class="w2"/>
              <g class="bv-a"><rect x="104" y="34" width="72" height="52" rx="6" class="c"/><rect x="104" y="34" width="72" height="11" rx="6" class="g"/><rect x="112" y="54" width="44" height="4" rx="2" class="w"/><rect x="112" y="64" width="30" height="4" rx="2" class="w"/></g>
              {% elif t.id == "oss" %}
              <rect x="40" y="22" width="120" height="66" rx="6" class="c"/>
              <path d="M76 40l-15 15 15 15M124 40l15 15-15 15" class="stroke"/><rect class="bv-a g" x="96" y="34" width="8" height="42" rx="4" transform="rotate(18 100 55)"/>
              <rect x="128" y="80" width="46" height="14" rx="7" class="pc"/>
              {% elif t.id == "audit" %}
              <path d="M100 14l38 13v25c0 24-17 37-38 44-21-7-38-20-38-44V27z" class="c"/><path d="M100 24l28 10v18c0 18-12 28-28 34z" class="w2"/>
              <circle class="bv-a g" cx="100" cy="54" r="11"/>
              {% endif %}
            </svg>
            {% endif %}
          </div>
          <div class="p-6">
            <h3 class="text-base font-semibold text-gray-900 dark:text-white">{{ t.title }}</h3>
            <p class="mt-1 text-sm/6 text-gray-600 dark:text-gray-400">{{ t.text }}</p>
          </div>
        </a>
      </li>
      {% endfor %}
    </ul>
    <p class="mt-8"><a href="/features/" class="text-sm/6 font-semibold text-primary-ink hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">See all features</a></p>
    <div class="mt-16">{% set playgroundCtaWide = true %}{% include "playground-cta.njk" %}</div>
  </div>
</section>
