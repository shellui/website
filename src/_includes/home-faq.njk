<section id="faq" class="bg-white dark:bg-gray-950">
  <div class="mx-auto max-w-7xl px-6 py-24 sm:pt-32 lg:px-8 lg:py-40">
    <div class="lg:grid lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-5">
        <h2 class="text-3xl font-semibold tracking-tight text-pretty text-gray-900 sm:text-4xl dark:text-white">Frequently asked questions</h2>
        <p class="mt-4 text-base/7 text-pretty text-gray-600 dark:text-gray-400">
          Can&rsquo;t find the answer you&rsquo;re looking for? Reach out to our
          <a href="/company/contact/" class="font-semibold text-primary-ink hover:text-primary dark:text-primary dark:hover:text-primary-ink">customer support</a>
          team.
        </p>
      </div>
      <div class="mt-10 lg:col-span-7 lg:mt-0">
        <dl class="space-y-10">
          {% for item in faq %}
            <div>
              <dt class="text-base/7 font-semibold text-gray-900 dark:text-white">{{ item.question }}</dt>
              <dd class="mt-2 text-base/7 text-gray-600 dark:text-gray-400">{{ item.answer }}</dd>
            </div>
          {% endfor %}
        </dl>
      </div>
    </div>
  </div>
</section>
