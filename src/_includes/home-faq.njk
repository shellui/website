<section id="faq" class="su-section-band bg-white page-x dark:bg-gray-950">
  {% set wireframeBandWidth = "7xl" %}
  {% include "su-wireframe-band-top.njk" %}
  <div class="mx-auto max-w-7xl su-column-box su-frame-corners px-4 py-24 sm:px-6 sm:pt-32 lg:py-40">
    {% include "su-frame-marks.njk" %}
    <div class="lg:grid lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-5">
        <h2 class="text-3xl font-semibold tracking-tight text-pretty text-gray-900 sm:text-4xl dark:text-white">Questions developers ask</h2>
        <p class="mt-4 text-base/7 text-pretty text-gray-600 dark:text-gray-400">
          If this list does not cover your case,
          <a href="/company/contact/" class="font-semibold text-primary-ink hover:text-primary dark:text-primary dark:hover:text-primary-ink">email the team</a>.
        </p>
      </div>
      <div class="mt-10 lg:col-span-7 lg:mt-0">
        <dl class="space-y-10">
          {% for item in faq %}
            <div>
              <dt class="text-base/7 font-semibold text-gray-900 dark:text-white">{{ item.question }}</dt>
              <dd class="mt-2 text-base/7 text-gray-600 dark:text-gray-400">{{ item.answer }}</dd>
            </div>
          {% endfor %}
        </dl>
      </div>
    </div>
  </div>
</section>
