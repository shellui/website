{% macro roleBadge(role) %}
<span class="role-badge inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium {% if role == 'Backend' %}bg-gray-100 text-gray-600 dark:bg-gray-800 dark:text-gray-300{% else %}bg-primary/10 text-primary-ink dark:text-primary{% endif %}">{{ role }}</span>
{% endmacro %}

{% macro heading(title, role) %}
<h2 class="flex flex-wrap items-center gap-2.5">{{ title }} {{ roleBadge(role) }}</h2>
{% endmacro %}

{% macro stackList(items) %}
<p class="stack-list flex flex-wrap items-center gap-2">
  <span class="text-sm font-medium text-gray-500 dark:text-gray-400">Stack</span>
  {% for item in items %}
    <span class="rounded-full bg-gray-100 px-2.5 py-0.5 text-sm font-medium text-gray-700 dark:bg-gray-800 dark:text-gray-300">{{ item }}</span>
  {% endfor %}
</p>
{% endmacro %}
