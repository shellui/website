{% set chrome = chrome or "modal" %}
{% set chromeLabels = {
  modal: "Modal",
  dialog: "Dialog",
  drawer: "Drawer",
  toast: "Toast",
  settings: "Settings"
} %}
<div class="shell-anim shell-anim--chrome shell-anim--{{ chrome }}" aria-hidden="true">
  <div class="shell-anim__device">
    <div class="shell-anim__bezel">
      <span class="shell-anim__dot"></span>
      <span class="shell-anim__dot"></span>
      <span class="shell-anim__dot"></span>
    </div>
    <div class="shell-anim__screen">
      <div class="shell-anim__app">
        <div class="shell-anim__body">
          <aside class="shell-anim__sidebar">
            <div class="shell-anim__sidebar-inner">
              <span class="shell-anim__brand"></span>
              <span class="shell-anim__nav-item is-on"></span>
              <span class="shell-anim__nav-item"></span>
              <span class="shell-anim__nav-item"></span>
              <span class="shell-anim__nav-item"></span>
            </div>
          </aside>
          <div class="shell-anim__main">
            <div class="shell-anim__content">
              <p class="shell-anim__label">Your Application</p>
              <div class="shell-anim__lines">
                <span></span>
                <span></span>
                <span></span>
              </div>
              <div class="shell-anim__tiles">
                <span></span>
                <span></span>
              </div>
            </div>
          </div>
        </div>
      </div>

      {% if chrome != "toast" %}
        <div class="shell-anim__scrim"></div>
      {% endif %}

      {% if chrome == "modal" %}
        <div class="shell-anim__modal">
          <div class="shell-anim__card-bar">
            <span class="shell-anim__card-title">Modal</span>
            <span class="shell-anim__card-x"></span>
          </div>
          <div class="shell-anim__card-body">
            <span></span>
            <span></span>
            <span></span>
          </div>
          <div class="shell-anim__card-actions">
            <span class="shell-anim__btn shell-anim__btn--ghost"></span>
            <span class="shell-anim__btn shell-anim__btn--primary"></span>
          </div>
        </div>
      {% elif chrome == "dialog" %}
        <div class="shell-anim__dialog">
          <span class="shell-anim__dialog-icon"></span>
          <div class="shell-anim__card-bar">
            <span class="shell-anim__card-title">Confirm</span>
          </div>
          <div class="shell-anim__card-body">
            <span></span>
            <span></span>
          </div>
          <div class="shell-anim__card-actions">
            <span class="shell-anim__btn shell-anim__btn--ghost"></span>
            <span class="shell-anim__btn shell-anim__btn--primary"></span>
          </div>
        </div>
      {% elif chrome == "drawer" %}
        <aside class="shell-anim__drawer">
          <div class="shell-anim__drawer-head">
            <span class="shell-anim__card-title">Details</span>
            <span class="shell-anim__card-x"></span>
          </div>
          <div class="shell-anim__card-body">
            <span></span>
            <span></span>
            <span></span>
          </div>
          <div class="shell-anim__tiles">
            <span></span>
            <span></span>
          </div>
        </aside>
      {% elif chrome == "toast" %}
        <div class="shell-anim__toast">
          <span class="shell-anim__toast-accent"></span>
          <span class="shell-anim__toast-icon"></span>
          <div class="shell-anim__toast-copy">
            <span></span>
            <span></span>
          </div>
        </div>
      {% elif chrome == "settings" %}
        <aside class="shell-anim__settings">
          <div class="shell-anim__settings-head">
            <span class="shell-anim__gear"></span>
            <span class="shell-anim__card-title">Settings</span>
          </div>
          <div class="shell-anim__setting">
            <span class="shell-anim__setting-label">Theme</span>
            <span class="shell-anim__toggle"><i></i></span>
          </div>
          <div class="shell-anim__setting">
            <span class="shell-anim__setting-label">Language</span>
            <span class="shell-anim__setting-value"></span>
          </div>
          <div class="shell-anim__setting">
            <span class="shell-anim__setting-label">Layout</span>
            <span class="shell-anim__mini-layouts"><i class="is-on"></i><i></i><i></i></span>
          </div>
        </aside>
      {% endif %}
    </div>
  </div>
  <p class="shell-anim__caption-static">{{ chromeLabels[chrome] }}</p>
</div>
