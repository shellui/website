---
layout: layouts/base.njk
---
<article class="page-top page-x bg-white pb-24 sm:pb-32 dark:bg-gray-950">
  <div class="mx-auto max-w-3xl text-base/7 text-gray-700 dark:text-gray-300">
    {% include "breadcrumbs.njk" %}
    {% if category %}
      <p class="text-base/7 font-semibold text-primary-ink">{{ category }}</p>
    {% endif %}
    <h1 class="mt-2 text-4xl font-semibold tracking-tight text-pretty text-gray-900 sm:text-5xl dark:text-white">{{ heading or title }}</h1>
    <p class="mt-3 text-sm/5 text-gray-500 dark:text-gray-400">
      <time datetime="{{ page.date.toISOString() }}">{{ page.date | readableDate }}</time>
      <span aria-hidden="true"> &middot; </span>
      {{ content | readingTime }} min read
    </p>
    <div class="mt-6 flex items-center gap-x-3">
      <img src="{{ authorImage or '/img/logo.png' }}" alt="{{ author or site.author }}" class="size-9 rounded-full bg-gray-50 object-contain p-0.5 dark:bg-gray-900" width="36" height="36" />
      <div class="text-sm/5">
        <p class="font-semibold text-gray-900 dark:text-white">{{ author or site.author }}</p>
        {% if authorRole %}
          <p class="text-gray-500 dark:text-gray-400">{{ authorRole }}</p>
        {% endif %}
      </div>
    </div>
    {% if heroImage %}
      <picture class="mt-10 block">
        <source type="image/webp" srcset="{{ heroImage }}-1200x630.webp 1200w, {{ heroImage }}-2400x1260.webp 2400w" sizes="(min-width: 48rem) 48rem, 100vw" />
        <img src="{{ heroImage }}-1200x630.png" srcset="{{ heroImage }}-1200x630.png 1200w, {{ heroImage }}-2400x1260.png 2400w" sizes="(min-width: 48rem) 48rem, 100vw" alt="{{ imageAlt }}" width="1200" height="630" class="w-full rounded-2xl bg-gray-50 ring-1 ring-gray-900/10 dark:bg-gray-900 dark:ring-white/10" fetchpriority="high" />
      </picture>
    {% endif %}
    {% if lede %}
      <p class="mt-8 text-xl/8 text-gray-700 dark:text-gray-300">{{ lede }}</p>
    {% endif %}
    <div class="article-body">
      {{ content | safe }}
    </div>
  </div>
</article>
