---
layout: layouts/base.njk
---
<article class="su-section-band page-top page-x bg-white pb-24 sm:pb-32 dark:bg-gray-950">
  {% set wireframeBandWidth = "3xl" %}
  {% include "su-wireframe-band-top.njk" %}
  {% set wireframeStageClass = "su-pattern-blueprint is-overlay" %}
  {% include "su-wireframe-stage.njk" %}
  <div class="mx-auto max-w-3xl su-column-box su-frame-corners px-4 py-8 text-base/7 text-gray-700 sm:px-6 sm:py-10 dark:text-gray-300">
    {% include "su-frame-marks.njk" %}
    {% include "breadcrumbs.njk" %}
    {% if category %}
      <p class="text-base/7 font-semibold text-primary-ink dark:text-primary">{{ category }}</p>
    {% endif %}
    <h1 class="mt-2 text-4xl font-semibold tracking-tight text-pretty text-gray-900 sm:text-5xl dark:text-white">{{ heading or title }}</h1>
    <p class="mt-3 text-sm/5 text-gray-500 dark:text-gray-400">
      <time datetime="{{ page.date.toISOString() }}">{{ page.date | readableDate }}</time>
      <span aria-hidden="true"> &middot; </span>
      {{ content | readingTime }} min read
    </p>
    <div class="mt-6 flex items-center gap-x-3">
      <img src="{{ authorImage or '/img/logo.png' }}" alt="{{ author or site.author }}" class="size-9 rounded-full bg-gray-50 object-contain p-0.5 dark:bg-gray-900" width="36" height="36" />
      <div class="text-sm/5">
        <p class="font-semibold text-gray-900 dark:text-white">{{ author or site.author }}</p>
        {% if authorRole %}
          <p class="text-gray-500 dark:text-gray-400">{{ authorRole }}</p>
        {% endif %}
      </div>
    </div>
    {% if lede %}
      <p class="mt-8 text-xl/8 text-gray-700 dark:text-gray-300">{{ lede }}</p>
    {% endif %}
    <div class="article-body">
      {{ content | safe }}
    </div>
  </div>
</article>
