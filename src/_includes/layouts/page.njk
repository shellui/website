---
layout: layouts/base.njk
---
<article class="su-section-band page-top page-x pb-20">
  {% set wireframeBandWidth = "3xl" %}
  {% include "su-wireframe-band-top.njk" %}
  <div class="mx-auto max-w-3xl su-column-box su-frame-corners px-4 py-8 sm:px-6 sm:py-10">
    {% include "su-frame-marks.njk" %}
    {% include "breadcrumbs.njk" %}
    {% if eyebrow %}
      <p class="mb-3 text-sm font-medium text-primary-ink dark:text-primary">{{ eyebrow }}</p>
    {% endif %}
    <h1 class="text-4xl font-bold text-gray-900 md:text-5xl dark:text-white">{{ heading or title }}</h1>
    {% if lede %}
      <p class="mt-4 text-lg text-gray-600 dark:text-gray-400">{{ lede }}</p>
    {% endif %}
    <div class="{% if prose == false %}mt-10{% else %}prose mt-10{% endif %}">
      {{ content | safe }}
    </div>
  </div>
</article>
