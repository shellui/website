---
layout: layouts/base.njk
---
<article class="px-4 py-20 pt-32 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-3xl">
    {% if eyebrow %}
      <p class="mb-3 text-sm font-medium text-secondary">{{ eyebrow }}</p>
    {% endif %}
    <h1 class="font-serif text-4xl font-bold text-primary md:text-5xl">{{ heading or title }}</h1>
    {% if lede %}
      <p class="mt-4 text-lg text-muted-foreground">{{ lede }}</p>
    {% endif %}
    <div class="prose mt-10">
      {{ content | safe }}
    </div>
  </div>
</article>
