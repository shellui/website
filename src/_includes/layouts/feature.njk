---
layout: layouts/base.njk
---
{% if centered %}
<div class="su-section-band bg-white page-x py-24 pt-32 sm:py-32 sm:pt-40 dark:bg-gray-950">
  {% set wireframeBandWidth = "2xl" %}
  {% include "su-wireframe-band-top.njk" %}
  <div class="mx-auto max-w-2xl su-column-box su-frame-corners px-4 py-10 text-center sm:px-6">
    {% include "su-frame-marks.njk" %}
    {% include "breadcrumbs.njk" %}
    {% if eyebrow %}
      <p class="text-base/7 font-semibold text-primary-ink dark:text-primary">{{ eyebrow }}</p>
    {% endif %}
    <h1 class="mt-2 text-5xl font-semibold tracking-tight text-gray-900 sm:text-7xl dark:text-white">{{ heading or title }}</h1>
    {% if lede %}
      <p class="mt-8 text-lg font-medium text-pretty text-gray-500 sm:text-xl/8 dark:text-gray-400">{{ lede }}</p>
    {% endif %}
  </div>
</div>
<article class="su-section-band page-x {% if playgroundCta %}pb-8{% else %}pb-24{% endif %}">
  {% set wireframeBandWidth = wide and "7xl" or "2xl" %}
  {% include "su-wireframe-band-top.njk" %}
  <div class="{% if wide %}mx-auto max-w-7xl su-column-box su-frame-corners px-4 py-10 sm:px-6 sm:py-12{% else %}prose mx-auto max-w-2xl su-column-box su-frame-corners px-4 py-10 sm:px-6{% endif %}">
    {% include "su-frame-marks.njk" %}
    {{ content | safe }}
  </div>
</article>
{% else %}
<div class="su-section-band page-top page-x bg-white pb-16 sm:pb-20 dark:bg-gray-950">
  {% set wireframeBandWidth = "7xl" %}
  {% include "su-wireframe-band-top.njk" %}
  <div class="mx-auto max-w-7xl su-column-box su-frame-corners px-4 py-10 sm:px-6 sm:py-12">
    {% include "su-frame-marks.njk" %}
    <div class="lg:max-w-2xl">
      {% include "breadcrumbs.njk" %}
      {% if eyebrow %}
        <p class="text-base/7 font-semibold text-primary-ink dark:text-primary">{{ eyebrow }}</p>
      {% endif %}
      <h1 class="mt-2 text-4xl font-semibold tracking-tight text-gray-900 sm:text-5xl dark:text-white">{{ heading or title }}</h1>
      {% if lede %}
        <p class="mt-6 text-lg font-medium text-pretty text-gray-500 sm:text-xl/8 dark:text-gray-400">{{ lede }}</p>
      {% endif %}
    </div>
    <div class="mt-10 {% if wide %}max-w-7xl{% else %}prose max-w-2xl{% endif %}">
      {{ content | safe }}
    </div>
  </div>
</div>
{% endif %}
{% if playgroundCta %}
<div class="su-section-band page-x pb-16 sm:pb-24">
  {% set wireframeBandWidth = "7xl" %}
  {% include "su-wireframe-band-top.njk" %}
  <div class="mx-auto max-w-7xl">
    {% set playgroundCtaWide = wide %}
    {% include "playground-cta.njk" %}
  </div>
</div>
{% endif %}
