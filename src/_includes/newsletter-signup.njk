{#
  Newsletter sign-up, adapted from the Tailwind Plus newsletter sections.
  Set before including:
    newsletterVariant: "details" (side-by-side with details), "split" (simple side-by-side), "stacked", or "form" (fields only)
    newsletterId: unique per page, prefixes the field ids
    newsletterHeadingLevel: optional, defaults to 2
#}
{%- set nlId = newsletterId or "newsletter" -%}
{%- set nlTag = "h" ~ (newsletterHeadingLevel or 2) -%}
{%- set nlAction = site.newsletter.endpoint ~ "/api/v1/public/newsletters/" ~ site.newsletter.key ~ "/subscribe" -%}

{%- macro nlForm(id, action, extraClass) -%}
  <form class="newsletter-form {{ extraClass }}" action="{{ action }}" method="post" novalidate>
    <div class="flex gap-x-3">
      <label for="{{ id }}-email" class="sr-only">Email address</label>
      <input
        id="{{ id }}-email"
        type="email"
        name="email"
        required
        autocomplete="email"
        spellcheck="false"
        placeholder="you@example.com"
        aria-describedby="{{ id }}-status"
        class="min-w-0 flex-auto rounded-md bg-background px-3.5 py-2 text-base text-foreground outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-primary sm:text-sm/6 dark:bg-white/5 dark:outline-white/10 dark:placeholder:text-gray-500"
      />
      <div class="absolute -left-[9999px]" aria-hidden="true">
        <label for="{{ id }}-website">Website</label>
        <input id="{{ id }}-website" type="text" name="website" tabindex="-1" autocomplete="off" />
      </div>
      <button
        type="submit"
        class="flex-none rounded-md bg-primary px-3.5 py-2.5 text-sm font-semibold text-primary-foreground shadow-xs hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary disabled:opacity-60"
      >
        Subscribe
      </button>
    </div>
    <p id="{{ id }}-status" class="mt-3 min-h-6 text-sm/6 text-muted-foreground" role="status" aria-live="polite"></p>
  </form>
{%- endmacro -%}

{%- macro nlUnavailable(extraClass) -%}
  <p class="{{ extraClass }} text-sm/6 text-muted-foreground">
    Sign-up opens soon. Until then, follow releases in the
    <a href="/changelog/" class="font-medium text-primary-ink hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:text-primary">changelog</a>
    or the
    <a href="{{ site.rss }}" class="font-medium text-primary-ink hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:text-primary">blog feed</a>.
  </p>
{%- endmacro -%}

{% if newsletterVariant == "form" %}
  <div class="relative">
    {% if site.newsletter.key %}
      {{ nlForm(nlId, nlAction, "") }}
    {% else %}
      {{ nlUnavailable("") }}
    {% endif %}
  </div>
{% elif newsletterVariant == "details" %}
  <div class="relative grid grid-cols-1 gap-x-8 gap-y-12 lg:grid-cols-2">
    <div class="max-w-xl lg:max-w-lg">
      <{{ nlTag }} class="text-3xl font-semibold tracking-tight text-pretty text-foreground sm:text-4xl">Get Shellui news by email</{{ nlTag }}>
      <p class="mt-4 text-lg text-muted-foreground">
        New releases, what changed, and what is coming next. Written by the team that builds Shellui.
      </p>
      {% if site.newsletter.key %}
        {{ nlForm(nlId, nlAction, "mt-6 max-w-md") }}
      {% else %}
        {{ nlUnavailable("mt-6 max-w-md") }}
      {% endif %}
    </div>
    <dl class="grid grid-cols-1 gap-x-8 gap-y-10 sm:grid-cols-2 lg:pt-2">
      <div class="flex flex-col items-start">
        <div class="rounded-md bg-muted p-2 ring-1 ring-border">
          <svg class="size-6 text-foreground" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
          </svg>
        </div>
        <dt class="mt-4 text-base font-semibold text-foreground">About once a month</dt>
        <dd class="mt-2 text-base/7 text-muted-foreground">One issue when there is something worth reading, usually around a release.</dd>
      </div>
      <div class="flex flex-col items-start">
        <div class="rounded-md bg-muted p-2 ring-1 ring-border">
          <svg class="size-6 text-foreground" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.05 4.575a1.575 1.575 0 1 0-3.15 0v3m3.15-3v-1.5a1.575 1.575 0 0 1 3.15 0v1.5m-3.15 0 .075 5.925m3.075.75V4.575m0 0a1.575 1.575 0 0 1 3.15 0V15M6.9 7.575a1.575 1.575 0 1 0-3.15 0v8.175a6.75 6.75 0 0 0 6.75 6.75h2.018a5.25 5.25 0 0 0 3.712-1.538l1.732-1.732a5.25 5.25 0 0 0 1.538-3.712l.003-2.024a.668.668 0 0 1 .198-.471 1.575 1.575 0 1 0-2.228-2.228 3.818 3.818 0 0 0-1.12 2.687M6.9 7.575V12m6.27 4.318A4.49 4.49 0 0 1 16.35 15m.002 0h-.002" />
          </svg>
        </div>
        <dt class="mt-4 text-base font-semibold text-foreground">No spam</dt>
        <dd class="mt-2 text-base/7 text-muted-foreground">You confirm your address first. Every issue has an unsubscribe link.</dd>
      </div>
    </dl>
  </div>
{% elif newsletterVariant == "split" %}
  <div class="relative grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-8">
    <{{ nlTag }} class="max-w-xl text-3xl font-semibold tracking-tight text-balance text-foreground sm:text-4xl lg:col-span-7">
      Want product news and updates? Sign up for the newsletter.
    </{{ nlTag }}>
    <div class="w-full max-w-md lg:col-span-5 lg:pt-2">
      {% if site.newsletter.key %}
        {{ nlForm(nlId, nlAction, "") }}
      {% else %}
        {{ nlUnavailable("") }}
      {% endif %}
      <p class="text-sm/6 text-muted-foreground">
        About once a month. Unsubscribe anytime.
        <a href="/newsletter/" class="font-semibold text-primary-ink hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:text-primary">About the newsletter</a>
      </p>
    </div>
  </div>
{% else %}
  <div class="relative">
    <{{ nlTag }} class="text-2xl font-semibold tracking-tight text-pretty text-foreground sm:text-3xl">Get Shellui news by email</{{ nlTag }}>
    <p class="mt-3 text-base/7 text-muted-foreground">
      Releases and product news, about once a month. Unsubscribe anytime.
      <a href="/newsletter/" class="font-semibold text-primary-ink hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:text-primary">About the newsletter</a>
    </p>
    {% if site.newsletter.key %}
      {{ nlForm(nlId, nlAction, "mt-6 max-w-md") }}
    {% else %}
      {{ nlUnavailable("mt-6 max-w-md") }}
    {% endif %}
  </div>
{% endif %}
