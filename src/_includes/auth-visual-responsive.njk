{# Authentication header visual: main 1200x630 from 640px, 3:2 thumbnail below. Windy dots (hero-dots.js, same as the layouts piece) drift behind the sign-in card and replace the static grid. #}
<style>.aud{--dot:#D1D5DB;position:relative;isolation:isolate;overflow:hidden;border-radius:.75rem;background:#F3F4F6 radial-gradient(var(--dot) 1px,transparent 1px) 12px 12px/24px 24px}.dark .aud{--dot:#1F2937;background-color:#030712}.aud-c{position:absolute;inset:0;width:100%;height:100%;z-index:-1;pointer-events:none}.aud:has(.aud-c[width]){background-image:none}.aud :is(.au,.aut) .bg{fill:transparent}.aud [fill="url(#au-d)"],.aud [fill="url(#aut-d)"]{display:none}</style>
<div class="aud" data-dots>
  <canvas class="aud-c" aria-hidden="true"></canvas>
  <div class="hidden w-full sm:block">{% include "auth-visual.njk" %}</div>
  <div class="w-full sm:hidden">{% include "auth-visual-thumb.njk" %}</div>
</div>
<script src="/assets/js/hero-dots.js" type="module"></script>
