.tl{position:relative;font-family:var(--font-sans,Inter),ui-sans-serif,system-ui,sans-serif;color:var(--tl-fg)}
.tl *{box-sizing:border-box}
.tl{--tl-font:var(--font-sans,Inter),ui-sans-serif,system-ui,sans-serif}.tl[data-theme="shadcn"]{--tl-font:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}.tl[data-theme="claude"]{--tl-font:ui-serif,Georgia,Cambria,"Times New Roman",serif}.tl[data-theme="amethyst-haze"]{--tl-font:Futura,"Century Gothic",Avenir,"URW Gothic",sans-serif}.tl[data-theme="amber-minimal"]{--tl-font:"Gill Sans","Gill Sans MT",Seravek,Calibri,"DejaVu Sans Condensed",sans-serif}.tl[data-theme="vercel"]{--tl-font:ui-monospace,"SF Mono",Menlo,Consolas,"DejaVu Sans Mono",monospace}.tl[data-theme="caffeine"]{--tl-font:ui-rounded,"SF Pro Rounded","Hiragino Maru Gothic ProN",Quicksand,Comfortaa,"Arial Rounded MT Bold",sans-serif}.tl[data-theme="ocean-breeze"]{--tl-font:Optima,Candara,"Noto Sans","Trebuchet MS",sans-serif}
.tl-wall{font-family:var(--tl-font)}.tl-wall>*{transition:opacity .18s ease}.tl.fs .tl-wall>*{opacity:.15}
.tl-strip{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin-bottom:20px}
.tl-pill{display:inline-flex;align-items:center;gap:6px;height:26px;padding:0 12px;border-radius:999px;border:1px dashed var(--color-primary);font:500 12px/1 "IBM Plex Mono",ui-monospace,Menlo,monospace;letter-spacing:.02em;color:var(--color-primary-ink);background:var(--color-background,transparent)}
.tl-pill b{font-weight:500;color:var(--color-muted-foreground,#6B7280)}
.tl-pill i{font-style:normal;transition:opacity .2s}
.tl-wall{background:var(--tl-bg);border-radius:16px;padding:20px;display:grid;gap:16px;grid-template-columns:repeat(4,minmax(0,1fr));align-items:start;transition:background-color .7s cubic-bezier(.32,.72,0,1)}
.tl-col{display:grid;gap:16px;min-width:0}
.tl-card,.tl-btn,.tl-in,.tl-badge,.tl-sw,.tl-sw span,.tl-tabs,.tl-tab,.tl-av,.tl-cal i,.tl-bar,.tl-track,.tl-range,.tl-thumb,.tl-toast,.tl-sel{transition:background-color .7s cubic-bezier(.32,.72,0,1),color .7s cubic-bezier(.32,.72,0,1),border-color .7s cubic-bezier(.32,.72,0,1),border-radius .7s cubic-bezier(.32,.72,0,1),box-shadow .7s cubic-bezier(.32,.72,0,1)}
.tl-card{background:var(--tl-card);color:var(--tl-cardf);border:1px solid var(--tl-bd);border-radius:calc(var(--tl-r) + 4px);padding:20px;box-shadow:0 1px 2px rgba(0,0,0,.05);min-width:0}
.tl-h{font-size:15px;font-weight:600;line-height:1.3;margin:0}
.tl-d{font-size:13px;line-height:1.45;color:var(--tl-muf);margin:4px 0 0}
.tl-l{font-size:13px;font-weight:500;margin:14px 0 6px;display:block}
.tl-in,.tl-sel{height:36px;width:100%;border:1px solid var(--tl-in);border-radius:calc(var(--tl-r) - 2px);background:transparent;padding:0 12px;font-size:13px;display:flex;align-items:center;justify-content:space-between;color:var(--tl-fg)}
.tl-in.ph{color:var(--tl-muf)}
.tl-row{display:flex;gap:8px;align-items:center}.tl-row.e{justify-content:flex-end;margin-top:18px}.tl-row.sb{justify-content:space-between}
.tl-btn{height:36px;padding:0 14px;border-radius:calc(var(--tl-r) - 2px);font-size:13px;font-weight:500;display:inline-flex;align-items:center;white-space:nowrap;border:1px solid transparent}
.tl-btn.p{background:var(--tl-p);color:var(--tl-pf)}.tl-btn.o{border-color:var(--tl-bd);background:var(--tl-bg);color:var(--tl-fg)}.tl-btn.s{background:var(--tl-sec);color:var(--tl-secf)}
.tl-badge{font-size:12px;font-weight:500;padding:2px 8px;border-radius:calc(var(--tl-r) - 2px);border:1px solid transparent;white-space:nowrap}
