{# A labeled illustration of the shell/app boundary, not a product screenshot. #}
<figure class="relative isolate min-w-0" aria-labelledby="hero-shell-caption">
  <div class="pointer-events-none absolute inset-0 -z-10 rounded-full bg-primary/10 blur-3xl" aria-hidden="true"></div>
  <div class="overflow-hidden rounded-xl border border-border bg-background">
    <div class="flex items-center justify-between gap-4 border-b border-border bg-muted px-4 py-4 sm:px-5">
      <span class="text-sm font-semibold text-foreground">Shellui</span>
      <span class="flex items-center gap-2 text-xs text-muted-foreground">
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="8" r="3"/><path d="M5 21v-2a7 7 0 0 1 14 0v2"/></svg>
        Your account
      </span>
    </div>
    <div class="grid min-h-80 grid-cols-[7rem_minmax(0,1fr)] sm:min-h-96 sm:grid-cols-[9rem_minmax(0,1fr)]">
      <div class="flex flex-col border-r border-border bg-muted p-2 sm:p-3">
        <div class="rounded-md bg-primary/15 px-2 py-2.5 text-xs font-semibold text-foreground sm:px-3 sm:text-sm">Your app</div>
        <div class="px-2 py-3 text-xs text-muted-foreground sm:px-3 sm:text-sm">Files</div>
        <div class="px-2 py-3 text-xs text-muted-foreground sm:px-3 sm:text-sm">Administration</div>
        <div class="mt-auto border-t border-border px-2 pt-4 pb-2 text-xs text-muted-foreground sm:px-3">Shared navigation</div>
      </div>
      <div class="flex min-w-0 flex-col p-4 sm:p-6">
        <div class="flex flex-1 flex-col items-center justify-center rounded-lg border border-dashed border-border px-3 py-8 text-center">
          <svg class="mb-5 size-9 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m8 7-5 5 5 5m8-10 5 5-5 5m-3-13-2 16"/></svg>
          <p class="text-xl font-semibold tracking-tight text-foreground sm:text-2xl">Your app</p>
          <p class="mt-3 max-w-48 text-sm/6 text-muted-foreground">Your framework.<br>Your interface.</p>
          <span class="mt-6 rounded-md bg-muted px-2.5 py-1 font-mono text-xs text-muted-foreground">iframe</span>
        </div>
        <p class="mt-4 text-center text-xs/5 text-muted-foreground">Connected through <span class="font-mono">@shellui/sdk</span></p>
      </div>
    </div>
  </div>
  <figcaption id="hero-shell-caption" class="mt-4 text-sm/6 text-muted-foreground">Shellui surrounds your app with shared navigation and services.</figcaption>
</figure>
