{%- set topicData = guidelines.bySlug["web-design"] -%}
<div class="guideline-handbook min-w-0">
  {% for section in webDesignRules.sections %}
    <section id="{{ section.id }}" class="guideline-section{% if not loop.first %} mt-16{% endif %}">
      <h2 class="text-2xl font-semibold tracking-tight text-gray-900 md:text-3xl dark:text-white">{{ section.title }}</h2>
      <p class="mt-3 max-w-2xl text-base/7 text-gray-600 dark:text-gray-400">{{ section.lede }}</p>
      <ul class="guideline-rules mt-8">
        {% for rule in section.rules %}
          <li>
            <p><strong>{{ rule.lead }}</strong> {{ rule.body }}</p>
          </li>
        {% endfor %}
      </ul>
    </section>
  {% endfor %}
</div>
