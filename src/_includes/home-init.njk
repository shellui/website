{% set defaultFramework = frameworks[0] %}
{% include "framework-icons.njk" %}

<section id="init" class="border-t border-gray-200 bg-gray-50 page-x py-24 dark:border-gray-800 dark:bg-gray-900/40">
  <div class="mx-auto max-w-7xl">
    <div class="max-w-2xl">
      <h2 class="text-3xl font-semibold tracking-tight text-pretty text-gray-900 sm:text-4xl dark:text-white">
        {{ includes.homeInit.title }}
      </h2>
      <p class="mt-4 text-lg text-gray-600 dark:text-gray-400">
        {{ includes.homeInit.lede | replace('shellui init', '<code class="rounded bg-gray-100 px-1.5 py-0.5 text-sm dark:bg-gray-800">shellui init</code>') | replace('shellui start', '<code class="rounded bg-gray-100 px-1.5 py-0.5 text-sm dark:bg-gray-800">shellui start</code>') | safe }}
      </p>
    </div>

    <div class="mt-12 max-w-3xl" data-framework-picker>
      <p class="text-base font-semibold text-gray-900 dark:text-white">{{ includes.homeInit.pickStarter }}</p>
      <p class="mt-2 text-base/7 text-gray-600 dark:text-gray-400">
        {{ includes.homeInit.pickStarterHelp | replace('shellui init', '<code class="rounded bg-gray-100 px-1 py-0.5 text-[0.8rem] dark:bg-gray-800">shellui init</code>') | safe }}
      </p>

      <div class="mt-5 flex flex-wrap gap-2" role="radiogroup" aria-label="{{ includes.homeInit.startersLabel }}">
        {% for item in frameworks %}
          <label class="framework-chip inline-flex min-h-11 cursor-pointer items-center gap-2 rounded-md border border-gray-200 bg-white px-3 text-sm font-medium text-gray-700 transition-colors hover:border-gray-300 hover:bg-gray-50 focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-primary dark:border-gray-800 dark:bg-gray-900 dark:text-gray-200 dark:hover:border-gray-700 dark:hover:bg-gray-800">
            <input
              class="sr-only"
              type="radio"
              name="init-framework"
              value="{{ item.id }}"
              data-command="{{ item.command }}"
              {% if item.id == defaultFramework.id %}checked{% endif %}
            >
            <svg class="size-5 shrink-0" aria-hidden="true" focusable="false">
              <use href="#fw-{{ item.id }}" />
            </svg>
            <span>{{ item.label }}</span>
          </label>
        {% endfor %}
      </div>

      <div class="cli-pane mt-6 overflow-hidden rounded-xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-950">
        <div class="border-b border-gray-200 px-3 py-1.5 font-mono text-[0.65rem] text-gray-500 dark:border-gray-800">terminal</div>
        <pre class="overflow-x-auto px-3 py-3 font-mono text-sm leading-relaxed text-gray-900 sm:px-4 dark:text-gray-50" aria-live="polite"><code><span class="select-none text-gray-400 dark:text-gray-600" aria-hidden="true">$ </span>npm install -g @shellui/cli
<span class="select-none text-gray-400 dark:text-gray-600" aria-hidden="true">$ </span><span data-init-command>{{ defaultFramework.command }}</span>
<span class="select-none text-gray-400 dark:text-gray-600" aria-hidden="true">$ </span>shellui start</code></pre>
      </div>

      <p class="mt-4 text-sm text-gray-500 dark:text-gray-400">
        <a href="{{ site.docs }}/installation" class="font-medium text-primary-ink hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:text-primary">{{ includes.homeInit.installCli }}</a>
        ·
        <a href="{{ site.docs }}/framework-starters" class="font-medium text-primary-ink hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:text-primary">{{ includes.homeInit.frameworkStarters }}</a>
        ·
        <a href="{{ site.docs }}/quickstart" class="font-medium text-primary-ink hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:text-primary">{{ includes.homeInit.createProject }}</a>
      </p>
      <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">
        {{ includes.homeInit.emptyHelp | replace('shellui init empty', '<code class="rounded bg-gray-100 px-1 py-0.5 font-mono text-[0.8rem] dark:bg-gray-800">shellui init empty</code>') | safe }}
      </p>
    </div>
  </div>
</section>
