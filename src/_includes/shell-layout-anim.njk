{% set layoutMode = layoutMode or "loop" %}
{% set isLoop = layoutMode == "loop" %}
{% set layoutLabels = {
  loop: "Sidebar, top bar, and window layouts",
  sidebar: "Sidebar layout",
  topbar: "Top bar layout",
  window: "Window layout"
} %}
<div class="shell-anim {% if isLoop %}shell-anim--layout{% else %}shell-anim--static shell-anim--{{ layoutMode }}{% endif %}" aria-hidden="true">
  <div class="shell-anim__device">
    <div class="shell-anim__bezel">
      <span class="shell-anim__dot"></span>
      <span class="shell-anim__dot"></span>
      <span class="shell-anim__dot"></span>
    </div>
    <div class="shell-anim__screen">
      <div class="shell-anim__desktop">
        <div class="shell-anim__desk-icons">
          <span></span>
          <span></span>
          <span></span>
        </div>
      </div>
      <div class="shell-anim__ghost">
        <div class="shell-anim__ghost-bar">
          <i></i><i></i><i></i>
        </div>
        <div class="shell-anim__ghost-body">
          <span></span>
          <span></span>
        </div>
      </div>
      <div class="shell-anim__app">
        <div class="shell-anim__titlebar">
          <div class="shell-anim__titlebar-inner">
            <span class="shell-anim__traffic"><i></i><i></i><i></i></span>
            <span class="shell-anim__win-title">Your Application</span>
          </div>
        </div>
        <div class="shell-anim__body">
          <aside class="shell-anim__sidebar">
            <div class="shell-anim__sidebar-inner">
              <span class="shell-anim__brand"></span>
              <span class="shell-anim__nav-item is-on"></span>
              <span class="shell-anim__nav-item"></span>
              <span class="shell-anim__nav-item"></span>
              <span class="shell-anim__nav-item"></span>
            </div>
          </aside>
          <div class="shell-anim__main">
            <header class="shell-anim__topbar">
              <div class="shell-anim__topbar-inner">
                <span class="shell-anim__nav-item is-on"></span>
                <span class="shell-anim__nav-item"></span>
                <span class="shell-anim__nav-item"></span>
                <span class="shell-anim__nav-item"></span>
              </div>
            </header>
            <div class="shell-anim__content">
              <p class="shell-anim__label">Your Application</p>
              <div class="shell-anim__lines">
                <span></span>
                <span></span>
                <span></span>
              </div>
              <div class="shell-anim__tiles">
                <span></span>
                <span></span>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="shell-anim__taskbar">
        <span class="is-on"></span>
        <span></span>
        <span></span>
      </div>
    </div>
  </div>
  {% if isLoop %}
    <p class="shell-anim__caption">
      <span class="shell-anim__mode shell-anim__mode--sidebar">Sidebar layout</span>
      <span class="shell-anim__mode shell-anim__mode--topbar">Top bar layout</span>
      <span class="shell-anim__mode shell-anim__mode--window">Window layout</span>
    </p>
  {% endif %}
  <p class="shell-anim__caption-static">{{ layoutLabels[layoutMode] }}</p>
</div>
