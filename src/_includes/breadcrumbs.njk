{%- if breadcrumbs and breadcrumbs.length > 1 -%}
<nav class="mb-6{% if centered %} flex justify-center{% endif %}" aria-label="Breadcrumb"><ol class="flex flex-wrap items-center gap-1.5 text-sm text-gray-500 dark:text-gray-400">{%- for crumb in breadcrumbs -%}<li class="inline-flex items-center gap-1.5">{%- if not loop.last -%}<a href="{{ crumb.path }}" class="transition-colors hover:text-gray-900 dark:hover:text-white">{{ crumb.name }}</a><svg class="size-3.5 shrink-0 text-gray-400 dark:text-gray-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" /></svg>{%- else -%}<span class="text-gray-700 dark:text-gray-300" aria-current="page">{{ crumb.name }}</span>{%- endif -%}</li>{%- endfor -%}</ol></nav>
{%- endif -%}
