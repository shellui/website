{% macro githubRepoButton(repo) %}
{{ outboundButton("https://github.com/" + repo, repo, "github") }}
{% endmacro %}

{% macro dockerImageButton(image) %}
{{ outboundButton("https://hub.docker.com/r/" + image, image, "docker") }}
{% endmacro %}
